-- Indices du jeu web (0 = MOTEUR ROUILLÉ). mn / mx = la boîte du moteur, en mètres, repère Roblox.
return {
	[0] = { nom = "MOTEUR ROUILLÉ", en = "RUSTY ENGINE", couleur = 0x7a5a3c, flamme = 0x8a6a30, cyl = 2, triangles = 1644, mn = { -0.611, -0.715, -0.368 }, mx = { 1.172, 0.826, 0.863 } },
	[1] = { nom = "BICYLINDRE", en = "TWIN-CYLINDER", couleur = 0x9fa8b0, flamme = 0xd08a3c, cyl = 2, triangles = 3312, mn = { -0.86, -0.518, -0.368 }, mx = { 0.964, 0.9, 0.991 } },
	[2] = { nom = "3 CYLINDRES", en = "3-CYLINDER", couleur = 0x9a8f7a, flamme = 0xff8a30, cyl = 3, triangles = 3816, mn = { -0.736, -0.518, -0.368 }, mx = { 0.932, 0.942, 0.79 } },
	[3] = { nom = "4 EN LIGNE", en = "INLINE-4", couleur = 0xa8a294, flamme = 0xffa040, cyl = 4, triangles = 4700, mn = { -0.886, -0.518, -0.368 }, mx = { 1.12, 0.942, 0.799 } },
