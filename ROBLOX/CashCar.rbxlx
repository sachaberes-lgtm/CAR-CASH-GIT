		m = { v = "lPgQBMTwFBYalPiAAsTwFBYalPgQBDwPFBYalPiAAjwPFBYabAcQBDwPFBYabAeAAjwPFBYabAcQBMTwFBYabAeAAsTwFBYa", t = "AAABAAIAAQADAAIABAAFAAYABQAHAAYABAAGAAIABgAAAAIABwAFAAEABQADAAEABgAHAAAABwABAAAAAgADAAQAAwAFAAQA" },
		c = { v = "", t = "" },
		l = { v = "", t = "" },
	},
	roue = {
		m = { v = "", t = "" },
		c = { v = "", t = "" },
	},
}
]]></ProtectedString></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX0000004E"><Properties><string name="Name">Ciel</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LE CIEL DU NIVEAU 1 : « le jour d'altitude ». Azur profond au zénith, horizon crème,
-- une mer de nuages sous la route (bâtie par chaque joueur, voir Decor), un soleil d'après-midi qui
-- couche les ombres. Posé par le SERVEUR : Lighting se réplique tout seul chez chaque joueur.
local Config = require(script.Parent:WaitForChild("Config"))
local Ciel = {}

local function obtenir(parent: Instance, classe: string, nom: string): any
	local x = parent:FindFirstChild(nom)
	if x and x.ClassName == classe then return x end
	if x then x:Destroy() end
	local n = Instance.new(classe)
	n.Name = nom
	n.Parent = parent
	return n
end

function Ciel.poser(Lighting: Lighting, ws: Workspace)
	local C = Config.CIEL
	Lighting.ClockTime = C.heure
	Lighting.GeographicLatitude = 23
	Lighting.Brightness = 2.6
	Lighting.Ambient = C.ambiance
	Lighting.OutdoorAmbient = C.ambianceExt
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ShadowSoftness = 0.25
	Lighting.GlobalShadows = true
	Lighting.ExposureCompensation = C.expo
	Lighting.ColorShift_Top = C.soleil
	Lighting.ColorShift_Bottom = Color3.fromRGB(120, 130, 190)

	local ciel = obtenir(Lighting, "Sky", "CielCashCar")
	ciel.SunAngularSize = 16
	ciel.MoonAngularSize = 7
	ciel.StarCount = 0
	ciel.CelestialBodiesShown = true

	local atm = obtenir(Lighting, "Atmosphere", "Altitude")
	atm.Density = C.brumeDensite
	atm.Offset = 0.2
	atm.Color = C.horizon
	atm.Decay = Color3.fromRGB(110, 165, 225) -- (le bleu profond du zénith teintait toute la brume en turquoise)
	atm.Glare = 0.3
	atm.Haze = C.brumeVoile

	local bloom = obtenir(Lighting, "BloomEffect", "Bloom")
	bloom.Intensity = 0.55
	bloom.Size = 28
	bloom.Threshold = 0.94

	local cc = obtenir(Lighting, "ColorCorrectionEffect", "Etalonnage")
	cc.Saturation = C.saturation
	cc.Contrast = C.contraste
	cc.Brightness = 0.01
	cc.TintColor = Color3.fromRGB(255, 250, 244)

	local rays = obtenir(Lighting, "SunRaysEffect", "Rayons")
	rays.Intensity = 0.05
	rays.Spread = 0.55

	-- les nuages dynamiques de Roblox, au-dessus : de la matière dans le ciel, zéro pièce
	local terrain = ws:FindFirstChildOfClass("Terrain")
	if terrain then
		local nu = obtenir(terrain, "Clouds", "Nuages")
		nu.Cover = 0.5
		nu.Density = 0.42
		nu.Color = Color3.fromRGB(255, 252, 246)
	end
end

return Ciel
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000059"><Properties><string name="Name">Client</string></Properties><Item class="ModuleScript" referent="RBX0000004F"><Properties><string name="Name">Bus</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LE BUS : le pilote ANNONCE ce qui arrive (une pièce, une figure, une pose, un décollage, une
-- mort, un portail…), les systèmes ÉCOUTENT (FLOW, frénésie, aura, missions, carrière, sons, jus…).
-- Aucun système n'a besoin de connaître les autres, et le pilote reste la physique.
--
--   Bus.on("piece", function(valeur, combo) … end)
--   Bus.emit("piece", valeur, combo)
--   Bus.etat()           → l'instantané de la partie (vitesse, position, mode…), fourni par le pilote
--   Bus.agir.argent(x)   → les leviers que le pilote prête aux systèmes (argent, nitro, vitesse, ralenti…)
local Bus = {}

local ecoutes: { [string]: { (...any) -> () } } = {}

function Bus.on(nom: string, f: (...any) -> ())
	local l = ecoutes[nom]
	if not l then
		l = {}
		ecoutes[nom] = l
	end
	table.insert(l, f)
end

-- une écoute qui plante ne casse JAMAIS la partie (le message part dans l'Output de Studio)
function Bus.emit(nom: string, ...: any)
	local l = ecoutes[nom]
	if not l then return end
	for _, f in l do
		local ok, err = pcall(f, ...)
		if not ok then warn("[CashCar] écoute « " .. nom .. " » : " .. tostring(err)) end
	end
end

Bus.etat = function(): { [string]: any } return {} end
Bus.agir = {} :: { [string]: (...any) -> any }

return Bus
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000050"><Properties><string name="Name">Construction</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LA CONSTRUCTION : de la piste calculée (des nombres) aux pièces qu'on voit.
-- Bâtie CHEZ LE JOUEUR, jamais sur le serveur : rien à envoyer, rien que le « streaming » puisse effacer.
--
-- La dalle est un ruban de TRIANGLES (deux coins par triangle, la vieille recette Roblox) : aucun trou
-- dans les virages, aucune pièce qui chevauche sa voisine (donc aucun scintillement). Les tronçons droits
-- sont fusionnés en longs quadrilatères : peu de pièces là où la route ne tourne pas.
-- Le long de chaque bord, un rail de NÉON cyan qui dépasse un peu dessus et dessous : il se lit des deux faces.
-- (1er retour de Sacha, capture Studio : « c'est normal que ça ressemble à ça ? » — la route lisse et claire se
-- lisait comme une nappe d'eau qui se fondait dans le ciel. Bitume d'asphalte sombre et MAT, pointillés,
-- rails plus larges : c'est un ruban de route, il doit trancher sur le ciel.)
local Config = require(script.Parent.Parent:WaitForChild("Config"))
local Piste = require(script.Parent.Parent:WaitForChild("Piste"))
local M = Config.M
local RH = Config.ROAD_HALF
local EP = Config.THICK * M
local R = Config.ROUTE

local Construction = {}

local modeleCoin = Instance.new("WedgePart")
modeleCoin.Anchored = true
modeleCoin.CanCollide = false
modeleCoin.CanQuery = false
modeleCoin.CanTouch = false
modeleCoin.TopSurface = Enum.SurfaceType.Smooth
modeleCoin.BottomSurface = Enum.SurfaceType.Smooth
modeleCoin.Material = Enum.Material.SmoothPlastic
modeleCoin.Color = R.bitume
modeleCoin.Reflectance = 0.06

local function part(taille: Vector3, cf: CFrame, couleur: Color3, matiere: Enum.Material, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = taille
	p.CFrame = cf
	p.Color = couleur
	p.Material = matiere
	p.Parent = parent
	return p
end

-- un triangle épais (épaisseur centrée sur le plan a-b-c) en deux coins
local function triangle(a: Vector3, b: Vector3, c: Vector3, ep: number, parent: Instance)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local droite = ac:Cross(ab)
	if droite.Magnitude < 1e-6 then return end
	droite = droite.Unit
	local haut = bc:Cross(droite).Unit
	local dos = bc.Unit
	local hauteur = math.abs(ab:Dot(haut))
	local w1 = modeleCoin:Clone()
	w1.Size = Vector3.new(ep, hauteur, math.abs(ab:Dot(dos)))
	w1.CFrame = CFrame.fromMatrix((a + b) / 2, droite, haut, dos)
	w1.Parent = parent
	local w2 = modeleCoin:Clone()
	w2.Size = Vector3.new(ep, hauteur, math.abs(ac:Dot(dos)))
	w2.CFrame = CFrame.fromMatrix((a + c) / 2, -droite, haut, -dos)
	w2.Parent = parent
end

local function rail(a: Vector3, b: Vector3, haut: Vector3, parent: Instance)
	local d = b - a
	local l = d.Magnitude
	if l < 0.01 then return end
	local cf = CFrame.lookAt((a + b) / 2, b, haut)
	local p = part(Vector3.new(0.7 * M, EP + 0.3 * M, l + 0.05), cf, R.neon, Enum.Material.Neon, parent)
	p.CastShadow = false
end

-- Bâtit la route d'une piste dans `dossier`. `ceder` est appelé régulièrement (bâtir en tâche de fond).
function Construction.route(piste: Piste.Piste, dossier: Instance, ceder: (() -> ())?)
	local F = piste.F
	local n = piste.n
	local demi = RH * M
	local i = 1
	local compte = 0
	while i < n do
		-- on allonge le quadrilatère tant que la route ne tourne ni ne plie (≤ 3°) et sur 30 m au plus
		local j = i + 1
		while j < n do
			local a, b = F[i], F[j + 1]
			if a.LookVector:Dot(b.LookVector) < 0.99863 or (j + 1 - i) * piste.DS > 30 * M then break end
			j += 1
		end
		local fa, fb = F[i], F[j]
		local mA = fa.Position - fa.UpVector * (EP / 2)
		local mB = fb.Position - fb.UpVector * (EP / 2)
		local gA, dA = mA - fa.RightVector * demi, mA + fa.RightVector * demi
		local gB, dB = mB - fb.RightVector * demi, mB + fb.RightVector * demi
		triangle(gA, dA, dB, EP, dossier)
		triangle(gA, dB, gB, EP, dossier)
		local rA, rB = demi - 0.35 * M, demi - 0.35 * M
		rail(mA - fa.RightVector * rA, mB - fb.RightVector * rB, (fa.UpVector + fb.UpVector).Unit, dossier)
		rail(mA + fa.RightVector * rA, mB + fb.RightVector * rB, (fa.UpVector + fb.UpVector).Unit, dossier)
		i = j
		compte += 1
		if ceder and compte % 60 == 0 then ceder() end
	end
	-- le marquage du niveau 1 (capture web) : des pointillés BLANCS sur les voies, tous les 12 m — sur un ruban
	-- de 56 m, ce sont eux qui disent la vitesse et l'échelle
	local haut = 0.03 * M
	local s = 6 * M
	local k = 0
	while s < piste.len - 6 * M do
		local f = Piste.repere(piste, s)
		local cfl = CFrame.fromMatrix(f.Position + f.UpVector * haut, f.RightVector, f.UpVector, -f.LookVector)
		for _, x in { -0.34, 0.34 } do
			local v = part(Vector3.new(0.45 * M, 0.06 * M, 6 * M), cfl + f.RightVector * (x * RH * M), R.voie, Enum.Material.SmoothPlastic, dossier)
			v.CastShadow = false
		end
		k += 1
		s += 12 * M
		if ceder and k % 150 == 0 then ceder() end
	end
end

-- le PORTAIL de fin de zone : un anneau d'or debout au-dessus de la route, et un voile qui scintille
function Construction.portail(piste: Piste.Piste, dossier: Instance)
	local f = Piste.repere(piste, piste.len - 20 * M)
	local Rr = 46 * M
	local c = f.Position + f.UpVector * (Rr * 0.62)
	local nb = 28
	for k = 0, nb - 1 do
		local a0 = 2 * math.pi * k / nb
		local a1 = 2 * math.pi * (k + 1) / nb
		local p0 = c + (f.RightVector * math.cos(a0) + f.UpVector * math.sin(a0)) * Rr
		local p1 = c + (f.RightVector * math.cos(a1) + f.UpVector * math.sin(a1)) * Rr
		local seg = part(Vector3.new(3 * M, 3 * M, (p1 - p0).Magnitude + 1),
			CFrame.lookAt((p0 + p1) / 2, p1, f.LookVector), (k % 2 == 0) and Color3.fromRGB(255, 215, 94) or Color3.fromRGB(255, 62, 200),
			Enum.Material.Neon, dossier)
		seg.CastShadow = false
	end
	local voile = part(Vector3.new(Rr * 1.9, Rr * 1.9, 0.5), CFrame.fromMatrix(c, f.RightVector, f.UpVector, -f.LookVector),
		Color3.fromRGB(255, 200, 120), Enum.Material.ForceField, dossier)
	voile.Transparency = 0.2
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Scale = Vector3.new(1, 1, 0.02)
	m.Parent = voile
end

-- ── les objets ──
local OR = Color3.fromRGB(255, 205, 64)
local AssetService = game:GetService("AssetService")
local EN_FRANCAIS = string.sub(game:GetService("Players").LocalPlayer.LocaleId or "fr", 1, 2) == "fr"

-- LE PLOT (L7344) : rouge DANGER, deux bandes blanches, 1,5 m — un seul maillage à facettes, bâti une fois puis copié.
-- (le maillage est centré sur sa boîte : on le pose à mi-hauteur)
local PLOT_H = 1.5
local modelePlot: BasePart? = nil
local function plotModele(): BasePart
	if modelePlot then return modelePlot end
	local ROUGE, BLANC = Color3.fromRGB(255, 59, 92), Color3.fromRGB(250, 250, 255)
	local ok, mp = pcall(function()
		local em = AssetService:CreateEditableMesh()
		-- le profil : { hauteur, rayon, couleur du tronçon AU-DESSUS }
		local profil = {
			{ 0, 0.72, ROUGE }, { 0.10, 0.72, ROUGE }, { 0.10, 0.44, ROUGE }, { 0.51, 0.345, BLANC }, { 0.73, 0.29, ROUGE },
			{ 0.94, 0.225, BLANC }, { 1.10, 0.18, ROUGE }, { 1.50, 0.075, ROUGE },
		}
		local N = 8
		local function pt(k: number, i: number): Vector3
			local q = profil[k]
			local a = (i / N) * math.pi * 2 + ((k <= 2) and math.pi / 4 or 0)
			local n = (k <= 2) and 4 or N -- le socle a quatre pans
			if k <= 2 then a = (math.floor(i / 2) / n) * math.pi * 2 + math.pi / 4 end
			return Vector3.new(math.cos(a) * q[2], q[1] - PLOT_H / 2, math.sin(a) * q[2]) * M
		end
		local function face(a: Vector3, b: Vector3, c: Vector3, col: Color3)
			if (b - a):Cross(c - a).Magnitude < 1e-6 then return end
			local f = em:AddTriangle(em:AddVertex(a), em:AddVertex(b), em:AddVertex(c))
			local id = em:AddColor(col, 1)
			em:SetFaceColors(f, { id, id, id })
		end
		for k = 1, #profil - 1 do
			for i = 0, N - 1 do
				local a, b = pt(k, i), pt(k, i + 1)
				local c, d = pt(k + 1, i), pt(k + 1, i + 1)
				face(a, c, b, profil[k][3])
				face(b, c, d, profil[k][3])
			end
		end
		for i = 0, N - 1 do -- le bouchon du haut
			face(pt(#profil, i), Vector3.new(0, PLOT_H / 2, 0) * M, pt(#profil, i + 1), ROUGE)
		end
		local fige = AssetService:CreateEditableMeshAsync(Content.fromObject(em), { FixedSize = true })
		em:Destroy()
		return AssetService:CreateMeshPartAsync(Content.fromObject(fige), { CollisionFidelity = Enum.CollisionFidelity.Box })
	end)
	local p: BasePart
	if ok and mp then
		p = mp
		p.DoubleSided = true
		p.Color = Color3.new(1, 1, 1)
	else
		p = Instance.new("Part") -- secours : une borne rouge
		p.Size = Vector3.new(0.7, PLOT_H, 0.7) * M
		p.Color = ROUGE
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	modelePlot = p
	return p
end

-- un objet : sa pièce, sa position. o.lat et o.h sont donnés dans le repère de SA face.
function Construction.unObjet(piste: Piste.Piste, o: Piste.Objet, dossier: Instance): any
	local f = Piste.repereFace(piste, o.s, o.face)
	local pos = f.Position + f.RightVector * o.lat + f.UpVector * o.h
	local p: BasePart
	if o.kind == "piece" then
		p = part(Vector3.new(0.3 * M, 2.36 * M, 2.36 * M), CFrame.fromMatrix(pos, f.RightVector, f.UpVector), OR, Enum.Material.Neon, dossier);
		(p :: Part).Shape = Enum.PartType.Cylinder
		p.CastShadow = false
	elseif o.kind == "pad" then
		-- la plaque de 5,5 × 9 m : fond d'encre, rails et chevrons d'or
		p = part(Vector3.new(5.5 * M, 0.12 * M, 9 * M), CFrame.fromMatrix(pos, f.RightVector, f.UpVector, -f.LookVector), Color3.fromRGB(28, 4, 48), Enum.Material.SmoothPlastic, dossier)
		p.CastShadow = false
		for c = -1.5, 1.5, 1 do
			for cote = -1, 1, 2 do
				local ch = part(Vector3.new(2.5 * M, 0.06 * M, 0.7 * M),
					CFrame.fromMatrix(pos + f.LookVector * (c * 2.25 * M) + f.RightVector * (cote * 1.05 * M) + f.UpVector * (0.07 * M), f.RightVector, f.UpVector, -f.LookVector)
						* CFrame.Angles(0, cote * 0.6, 0),
					Color3.fromRGB(255, 242, 122), Enum.Material.Neon, dossier)
				ch.CastShadow = false
				ch.Parent = p
			end
		end
		for cote = -1, 1, 2 do
			local rail = part(Vector3.new(0.22 * M, 0.08 * M, 9 * M), CFrame.fromMatrix(pos + f.RightVector * (cote * 2.6 * M) + f.UpVector * (0.06 * M), f.RightVector, f.UpVector, -f.LookVector),
				Color3.fromRGB(255, 200, 60), Enum.Material.Neon, dossier)
			rail.CastShadow = false
			rail.Parent = p
		end
	elseif o.kind == "plot" then
		p = plotModele():Clone()
		p.CFrame = CFrame.fromMatrix(pos + f.UpVector * (PLOT_H / 2 * M), f.RightVector, f.UpVector)
		p.Parent = dossier
	elseif o.kind == "flaque" then
		-- la flaque : un disque noir glacé, liseré violet
		local r = (o.r or 2.5) * M
		p = part(Vector3.new(0.06 * M, r * 2.4, r * 2.4), CFrame.fromMatrix(pos, f.UpVector, -f.RightVector), Color3.fromRGB(18, 20, 25), Enum.Material.SmoothPlastic, dossier);
		(p :: Part).Shape = Enum.PartType.Cylinder
		p.Reflectance = 0.45
		p.CastShadow = false
		local lis = part(Vector3.new(0.04 * M, r * 2.75, r * 2.75), CFrame.fromMatrix(pos - f.UpVector * (0.02 * M), f.UpVector, -f.RightVector), Color3.fromRGB(74, 58, 114), Enum.Material.SmoothPlastic, dossier);
		(lis :: Part).Shape = Enum.PartType.Cylinder
		lis.Transparency = 0.55
		lis.CastShadow = false
		lis.Parent = p
	elseif o.kind == "fruit" then
		-- un fruit (provisoire : une boule à sa couleur et sa feuille ; les six maillages du jeu web viendront de la cuisson)
		local fd = Config.FRUITS[o.fruit or 1]
		local t = fd.taille * M
		p = part(Vector3.new(t, t * fd.plat, t), CFrame.fromMatrix(pos, f.RightVector, f.UpVector), fd.couleur, Enum.Material.SmoothPlastic, dossier);
		(p :: Part).Shape = Enum.PartType.Ball
		p.Reflectance = 0.12
		p.CastShadow = false
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
		local feuille = part(Vector3.new(0.5 * M, 0.12 * M, 0.9 * M), CFrame.fromMatrix(pos + f.UpVector * (t * fd.plat * 0.5), f.RightVector, f.UpVector) * CFrame.Angles(0.5, 0.6, 0),
			Color3.fromRGB(70, 190, 80), Enum.Material.SmoothPlastic, dossier)
		feuille.CastShadow = false
		feuille.Parent = p
		local w = Instance.new("WeldConstraint")
		feuille.Anchored = false
		w.Part0, w.Part1 = p, feuille
		w.Parent = feuille
	else -- cristal de pouvoir : un diamant qui tourne, et son étiquette
		local pw = Config.POUVOIRS[o.pw or "n"]
		p = part(Vector3.new(2.4 * M, 2.4 * M, 2.4 * M), CFrame.fromMatrix(pos, f.RightVector, f.UpVector) * CFrame.Angles(math.pi / 4, 0, math.pi / 4),
			pw.couleur, Enum.Material.Neon, dossier)
		p.CastShadow = false
		p.Transparency = 0.15
		local bb = Instance.new("BillboardGui")
		bb.Size = UDim2.fromOffset(180, 40)
		bb.StudsOffsetWorldSpace = f.UpVector * (3 * M)
		bb.AlwaysOnTop = false
		bb.MaxDistance = 160 * M
		bb.LightInfluence = 0
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.FontFace = Font.new("rbxasset://fonts/families/PressStart2P.json")
		t.TextScaled = true
		t.TextColor3 = pw.couleur
		t.TextStrokeColor3 = Color3.fromRGB(28, 4, 48)
		t.TextStrokeTransparency = 0
		t.Text = EN_FRANCAIS and pw.nom or pw.nomEN
		t.Name = "Nom"
		t.Parent = bb
		bb.Parent = p
	end
	p.Name = o.kind
	return { o = o, p = p, pos = pos, pris = false, base = p.CFrame }
end

function Construction.objets(piste: Piste.Piste, dossier: Instance, ceder: (() -> ())?): { any }
	local liste = {}
	plotModele()
	for k, o in piste.objets do
		liste[k] = Construction.unObjet(piste, o, dossier)
		if ceder and k % 150 == 0 then ceder() end
	end
	return liste
end

-- ── les cumulus le long de la route : des bulles blanches ovales, pas une texture ──
-- (la MER de nuages ne se bâtit plus par zone — 2 à 4 km sous le départ, la brume l'effaçait : elle suit
-- la caisse, voir Client/Mer)
function Construction.nuages(piste: Piste.Piste, dossier: Instance, graine: number, ceder: (() -> ())?)
	local rnd = Random.new(graine + 17)
	local function bulle(c: Vector3, t: Vector3, teinte: Color3)
		local p = part(Vector3.new(math.min(2040, t.X), math.min(2040, t.Y), math.min(2040, t.Z)), CFrame.new(c), teinte, Enum.Material.SmoothPlastic, dossier)
		p.CastShadow = false
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	-- les cumulus : des grappes à l'écart de la route (jamais DANS le couloir de la route)
	local function libre(c: Vector3, rayon: number): boolean
		for i = 1, piste.n, 8 do
			if (piste.F[i].Position - c).Magnitude < rayon then return false end
		end
		return true
	end
	for _ = 1, 80 do
		local i = rnd:NextInteger(1, piste.n)
		local f = piste.F[i]
		local cote = rnd:NextNumber() < 0.5 and -1 or 1
		local c = f.Position + f.RightVector * cote * rnd:NextNumber(160, 420) * M + Vector3.new(0, rnd:NextNumber(-140, -30) * M, 0)
		local taille = rnd:NextNumber(40, 90) * M
		local n = rnd:NextInteger(4, 7) -- tiré AVANT le test : la suite du tirage ne dépend pas de la place
		if not libre(c, taille * 2.2 + (RH + 20) * M) then continue end
		for _ = 1, n do
			local d = Vector3.new(rnd:NextNumber(-1, 1), rnd:NextNumber(-0.3, 0.6), rnd:NextNumber(-1, 1)) * taille
			local t = taille * rnd:NextNumber(0.6, 1.1)
			bulle(c + d, Vector3.new(t * 1.4, t * 0.9, t * 1.3), Color3.fromRGB(252, 252, 250))
		end
		if ceder then ceder() end
	end
end

return Construction
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000051"><Properties><string name="Name">Controles</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LES COMMANDES. Trois mondes, une seule sortie :
--   Controles.volant  (−1 gauche … +1 droite)
--   Controles.assiette (+1 = PIQUÉ, nez vers le bas ; −1 = CABRER) — ne sert qu'en l'air
--   Controles.nitro   (vrai tant qu'on tient)
--   Controles.frein   (au sol : freiner)
-- Clavier : ← → (ou Q/A et D) · ↑ ↓ (ou Z/W et S) · ESPACE ou MAJ = nitro.
-- Manette : stick gauche · R2 ou A = nitro · L2 ou B = frein.
-- Tactile : le HUD pose ses doigts dans Controles.tactile (la moitié gauche est le volant, le pouce droit la nitro).
-- Le gaz est AUTOMATIQUE partout (comme sur téléphone dans le jeu web) : on ne réclame jamais un troisième doigt.
local UserInputService = game:GetService("UserInputService")

local Controles = {
	volant = 0, assiette = 0, nitro = false, frein = false,
	tactile = { actif = false, x = 0, y = 0, nitro = false },
	surPause = nil :: (() -> ())?,
}

local tenues: { [Enum.KeyCode]: boolean } = {}
local pad = { x = 0, y = 0, r2 = false, l2 = false }

local G = { [Enum.KeyCode.Left] = true, [Enum.KeyCode.A] = true, [Enum.KeyCode.Q] = true }
local D = { [Enum.KeyCode.Right] = true, [Enum.KeyCode.D] = true }
local H = { [Enum.KeyCode.Up] = true, [Enum.KeyCode.W] = true, [Enum.KeyCode.Z] = true }
local B = { [Enum.KeyCode.Down] = true, [Enum.KeyCode.S] = true }
local N = { [Enum.KeyCode.Space] = true, [Enum.KeyCode.LeftShift] = true, [Enum.KeyCode.RightShift] = true,
	[Enum.KeyCode.ButtonA] = true, [Enum.KeyCode.ButtonR1] = true }
local F = { [Enum.KeyCode.ButtonB] = true, [Enum.KeyCode.ButtonL1] = true }

local function un(t: { [Enum.KeyCode]: boolean }): boolean
	for k in t do
		if tenues[k] then return true end
	end
	return false
end

UserInputService.InputBegan:Connect(function(io, gp)
	if io.KeyCode == Enum.KeyCode.P or io.KeyCode == Enum.KeyCode.ButtonStart then
		if Controles.surPause then Controles.surPause() end
		return
	end
	if gp and io.UserInputType == Enum.UserInputType.Keyboard then return end -- on tape dans le chat
	tenues[io.KeyCode] = true
end)
UserInputService.InputEnded:Connect(function(io)
	tenues[io.KeyCode] = nil
end)
UserInputService.InputChanged:Connect(function(io)
	if io.KeyCode == Enum.KeyCode.Thumbstick1 then
		pad.x, pad.y = io.Position.X, io.Position.Y
	elseif io.KeyCode == Enum.KeyCode.ButtonR2 then
		pad.r2 = io.Position.Z > 0.3
	elseif io.KeyCode == Enum.KeyCode.ButtonL2 then
		pad.l2 = io.Position.Z > 0.3
	end
end)
UserInputService.WindowFocusReleased:Connect(function()
	table.clear(tenues) -- on a changé de fenêtre : plus aucune touche n'est tenue
end)

local function zm(v: number, z: number): number -- zone morte + courbe douce (1,35 comme le volant tactile du jeu web)
	local a = math.abs(v)
	if a < z then return 0 end
	local n = (a - z) / (1 - z)
	return math.sign(v) * n ^ 1.35
end

-- à appeler une fois par image
function Controles.lire()
	local v = (un(D) and 1 or 0) - (un(G) and 1 or 0)
	local a = (un(H) and 1 or 0) - (un(B) and 1 or 0)
	local px = zm(pad.x, 0.12)
	local py = zm(pad.y, 0.2)
	if px ~= 0 then v = px end
	if py ~= 0 then a = py end
	local t = Controles.tactile
	if t.actif then
		v = t.x
		a = t.y
	end
	Controles.volant = math.clamp(v, -1, 1)
	Controles.assiette = math.clamp(a, -1, 1)
	Controles.nitro = un(N) or pad.r2 or t.nitro
	Controles.frein = un(B) or un(F) or pad.l2 or (t.actif and t.y < -0.65)
end

return Controles
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000052"><Properties><string name="Name">Garage</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LE GARAGE (mode BOUTIQUE du jeu web : #garage, #gTop, #gBottom).
-- Un ATELIER en 3D (plateau tournant cerclé de cyan, porte sectionnelle, néons, bazar de garagiste) et, par-dessus,
-- la même interface que le web : le COMPTE en haut à gauche, la fiche de la caisse (nom, barre à la couleur de sa
-- rareté, rang « 12 / 68 », sa condition si elle est fermée), et en bas à droite la CONSOLE : onglets, pastilles de
-- famille (possédées / total), bande de vignettes, puis HOME · BOUTIQUE · le bouton de décision · JOUER.
--
-- Les règles sont celles du web :
--   · la rareté se lit à la COULEUR seule (barre, pastille, liseré de vignette) ;
--   · UN seul lingot d'or : s'il y a une décision (ACHETER, ÉQUIPER), c'est elle qui est en or et JOUER passe en laque ;
--   · acheter = un seul appui, sans confirmation, et la caisse n'est PAS équipée d'office ;
--   · JOUER équipe la caisse montrée si elle est ouverte, puis lance ;
--   · Config.TEST_CAISSES (comme TEST_CAISSES du web) : tout s'équipe, mais la vraie condition reste écrite.
-- L'argent et la possession vivent au SERVEUR (Profils) : ici on DEMANDE, le serveur vérifie.
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local CC = script.Parent.Parent
local Config = require(CC:WaitForChild("Config"))
local Caisse = require(CC:WaitForChild("Caisse"))
local Hud = require(script.Parent:WaitForChild("Hud"))
local Sons = require(script.Parent:WaitForChild("Sons"))

local M = Config.M
local Catalogue = Caisse.Catalogue
local K, C, FR = Hud.kit, Hud.C, Hud.FR
local inst = K.inst

local Garage = { ouvert = false }

-- ════════ les mots ════════
local L = FR and {
	voitures = "VOITURES", peinture = "PEINTURE", ailes = "AILES", trainees = "TRAINEES",
	home = "HOME", boutique = "BOUTIQUE", jouer = "JOUER", acheter = "ACHETER", manque = "IL MANQUE",
	equiper = "EQUIPER", verrou = "VERROUILLEE", enBoutique = "EN BOUTIQUE", aToi = "A TOI !",
	ilTeManque = "IL TE MANQUE ", bientot = "BIENTOT DISPONIBLE",
	carnet = "SE GAGNE EN RELEVANT 3 DEFIS", carrN = "ATTRAPE-LA AU NIVEAU 10 DES NUAGES  (%d / 10)",
	carrV = "BATS LE BANQUIER AU NIVEAU 10 DE LA VILLE  (%d / 10)", aura = "RANG D'AURA « %s »   (le tien : « %s »)",
	rangs = { "ANONYME", "REMARQUE", "ON PARLE DE TOI", "REPUTE", "LEGENDE LOCALE", "STAR DU BITUME", "MYTHE", "DIVINITE DU CIEL" },
} or {
	voitures = "CARS", peinture = "PAINT", ailes = "WINGS", trainees = "TRAILS",
	home = "HOME", boutique = "SHOP", jouer = "PLAY", acheter = "BUY", manque = "SHORT BY",
	equiper = "EQUIP", verrou = "LOCKED", enBoutique = "IN THE SHOP", aToi = "YOURS!",
	ilTeManque = "SHORT BY ", bientot = "COMING SOON",
	carnet = "WON BY BEATING 3 CHALLENGES", carrN = "CATCH HER IN CLOUDS LEVEL 10  (%d / 10)",
	carrV = "BEAT THE BANKER IN CITY LEVEL 10  (%d / 10)", aura = 'AURA RANK "%s"   (yours: "%s")',
	rangs = { "NOBODY", "NOTICED", "THEY'RE TALKING ABOUT YOU", "RENOWNED", "LOCAL LEGEND", "ASPHALT STAR", "MYTH", "SKY GOD" },
}
local SEUILS_AURA = { 0, 400, 1500, 4000, 10000, 24000, 55000, 120000 } -- AURA_RANKS du web

-- ════════ les familles (RARETES du web) : la couleur EST la rareté ════════
local RARETES = {
	{ id = "commun", c = Color3.fromRGB(185, 196, 214) },
	{ id = "rare", c = Color3.fromRGB(77, 184, 255) },
	{ id = "epique", c = Color3.fromRGB(199, 125, 255) },
	{ id = "legendaire", c = Color3.fromRGB(255, 215, 94) },
	{ id = "defi", c = Color3.fromRGB(94, 227, 122) },
}
local COULEUR_RAR: { [string]: Color3 } = {}
for _, r in RARETES do COULEUR_RAR[r.id] = r.c end
local function eurNombre(s: string?): number
	if not s then return 0 end
	local n = tonumber((string.gsub(string.gsub(s, ",", "."), "[^%d%.]", "")))
	return n or 0
end
local function eurTexte(s: string): string
	if FR then return s end
	return string.format("€%.2f", eurNombre(s))
end
local function ordre(i: number): number -- carOrdre : dans une famille, du plus accessible au plus dur
	local k = Catalogue[i].cond
	if k.k == "depart" then return -1 end
	if k.k == "prix" then return k.v end
	if k.k == "premium" then return eurNombre(k.eur) end
	if k.k == "carnet" then return k.v end
	if k.k == "aura" then return 100 + k.v end
	return 1e9
end
local FAMILLES: { [string]: { number } } = {}
local LISTE: { number } = {} -- tout le garage, dans l'ordre des familles (garageListe)
local RANG: { [number]: number } = {}
do
	for _, r in RARETES do FAMILLES[r.id] = {} end
	for i, f in Catalogue do
		table.insert(FAMILLES[f.rar] or FAMILLES.commun, i)
	end
	for _, r in RARETES do
		table.sort(FAMILLES[r.id], function(a, b)
			local oa, ob = ordre(a), ordre(b)
			if oa ~= ob then return oa < ob end
			return a < b
		end)
		for _, i in FAMILLES[r.id] do
			table.insert(LISTE, i)
			RANG[i] = #LISTE
		end
	end
end

-- ════════ l'état ════════
local ctx: any = nil
local montre = 0          -- la caisse sur le plateau
local famille = "commun"  -- la famille dont on voit la bande
local onglet = "voiture"
local function profil(): any return ctx.profil() end
local function possede(i: number): boolean return table.find(profil().caisses, i) ~= nil end
local function rangAura(a: number): number
	local r = 1
	for k, v in SEUILS_AURA do if a >= v then r = k end end
	return r
end
local function gagnee(i: number): boolean -- carUnlockedVrai
	local k = Catalogue[i].cond
	if k.k == "depart" or possede(i) then return true end
	if k.k == "aura" then return rangAura(profil().aura or 0) - 1 >= k.v end
	return false
end
local function ouverte(i: number): boolean return Config.TEST_CAISSES == true or gagnee(i) end

-- ════════════════════════════════════════════════════════════════════════════════════════════════
-- L'ATELIER (bâti une fois, à la première visite ; hors du monde tant que le garage est fermé)
-- Repère : mètres, centre du plateau à l'origine, la PORTE sur le mur +Z. La caméra regarde vers la porte.
-- ════════════════════════════════════════════════════════════════════════════════════════════════
local O = Vector3.new(0, 9000, 0)
local LARG, PROF, HAUT = 22, 26, 6.2
local POD = 0.12
local dossier: Folder? = nil
local plateau: Model
local porte: Model
local flammes: { BasePart } = {}
local tubeMalade: BasePart
local lampeCle: BasePart
local lampeRive: BasePart
local feuPorte: PointLight
local scanner: BasePart
local cible: Model
local vitrine: Model? = nil

local function P(x: number, y: number, z: number): Vector3 return O + Vector3.new(x, y, z) * M end
local function bloc(nom: string, sx: number, sy: number, sz: number, x: number, y: number, z: number, couleur: Color3,
	matiere: Enum.Material?, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = nom
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = Vector3.new(sx, sy, sz) * M
	p.CFrame = CFrame.new(P(x, y, z))
	p.Color = couleur
	p.Material = matiere or Enum.Material.SmoothPlastic
	p.Parent = parent or dossier
	return p
end
-- un cylindre DEBOUT (axe vertical)
local function cyl(nom: string, rayon: number, h: number, x: number, y: number, z: number, couleur: Color3,
	matiere: Enum.Material?, parent: Instance?): Part
	local p = bloc(nom, h, rayon * 2, rayon * 2, x, y, z, couleur, matiere, parent)
	p.Shape = Enum.PartType.Cylinder
	p.CFrame = CFrame.new(P(x, y, z)) * CFrame.Angles(0, 0, math.pi / 2)
	return p
end
local function lampe(nom: string, x: number, y: number, z: number, couleur: Color3, eclat: number, portee: number, ombres: boolean?): (Part, PointLight)
	local p = bloc(nom, 0.1, 0.1, 0.1, x, y, z, couleur)
	p.Transparency = 1
	p.CastShadow = false
	local l = Instance.new("PointLight")
	l.Color = couleur
	l.Brightness = eclat
	l.Range = portee
	l.Shadows = ombres == true
	l.Parent = p
	return p, l
end
local function ecriteau(piece: BasePart, face: Enum.NormalId, txt: string, couleur: Color3, corps: number, fond: Color3?)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 40
	sg.LightInfluence = 0
	sg.Brightness = 2
	sg.Parent = piece
	local t = inst("TextLabel", { BackgroundTransparency = fond and 0 or 1, BackgroundColor3 = fond or Color3.new(), Size = UDim2.fromScale(1, 1),
		FontFace = K.PIX, Text = txt, TextColor3 = couleur, TextSize = corps, TextWrapped = true }, sg)
	return t
end

local NUIT = Color3.fromRGB(24, 26, 44)
local MUR = Color3.fromRGB(36, 42, 74)
local PLINTHE = Color3.fromRGB(26, 30, 54)
local ACIER = Color3.fromRGB(58, 64, 92)
local CYAN = Color3.fromRGB(95, 240, 255)

local function batir()
	local d = Instance.new("Folder")
	d.Name = "CashCarAtelier"
	dossier = d
	-- ── la coque : sol verni, quatre murs, plafond ──
	local sol = bloc("Sol", LARG + 1, 0.4, PROF + 1, 0, -0.2, 0, NUIT)
	sol.Reflectance = 0.07
	bloc("Plafond", LARG + 1, 0.4, PROF + 1, 0, HAUT + 0.2, 0, Color3.fromRGB(16, 16, 28))
	bloc("MurFond", LARG + 1, HAUT, 0.4, 0, HAUT / 2, -PROF / 2 - 0.2, MUR)
	bloc("MurG", 0.4, HAUT, PROF + 1, LARG / 2 + 0.2, HAUT / 2, 0, MUR)
	bloc("MurD", 0.4, HAUT, PROF + 1, -LARG / 2 - 0.2, HAUT / 2, 0, MUR)
	-- le mur de la PORTE : deux piliers et un linteau autour d'une baie de 10 × 4,9 m
	bloc("PilierG", 6, HAUT, 0.4, 8, HAUT / 2, PROF / 2 + 0.2, MUR)
	bloc("PilierD", 6, HAUT, 0.4, -8, HAUT / 2, PROF / 2 + 0.2, MUR)
	local linteau = bloc("Linteau", 10, HAUT - 4.9, 0.4, 0, 4.9 + (HAUT - 4.9) / 2, PROF / 2 + 0.2, MUR)
	ecriteau(linteau, Enum.NormalId.Front, "CASH CAR", Color3.fromRGB(255, 90, 200), 46)
	for _, s in { -1, 1 } do
		bloc("Plinthe", 0.08, 1.0, PROF, s * (LARG / 2 - 0.02), 0.5, 0, PLINTHE)
		bloc("Montant", 0.3, 4.9, 0.3, s * 5.15, 2.45, PROF / 2 - 0.1, Color3.fromRGB(255, 196, 40))
		-- les bandes orange au sol, du plateau à la porte
		local b = bloc("Bande", 0.12, 0.02, 7.4, s * 3.3, 0.012, 9.2, Color3.fromRGB(255, 150, 30))
		b.CastShadow = false
	end
	bloc("PlintheFond", LARG, 1.0, 0.08, 0, 0.5, -PROF / 2 + 0.02, PLINTHE)
	-- les poutres et les six tubes (un qui grésille)
	for k, z in { -7.5, 0, 7.5 } do
		bloc("Poutre", LARG, 0.3, 0.3, 0, HAUT - 0.25, z, ACIER, Enum.Material.Metal)
		for _, x in { -5, 5 } do
			local t = bloc("Tube", 3.2, 0.12, 0.14, x, HAUT - 0.5, z, Color3.fromRGB(226, 236, 255), Enum.Material.Neon)
			t.CastShadow = false
			if k == 1 and x == 5 then tubeMalade = t end
		end
	end
	lampe("Plafonnier", 0, HAUT - 0.9, 0, Color3.fromRGB(190, 205, 255), 0.3, 60, true)

	-- ── LA PORTE sectionnelle (elle se lève au lâcher) et le rideau de FEU derrière ──
	porte = Instance.new("Model")
	porte.Name = "Porte"
	for k = 0, 5 do
		local pan = bloc("Panneau", 10, 0.78, 0.12, 0, 0.42 + k * 0.816, PROF / 2 - 0.05, Color3.fromRGB(214, 218, 230), Enum.Material.Metal, porte)
		if k == 3 or k == 4 then
			for _, x in { -3, 0, 3 } do
				bloc("Hublot", 1.3, 0.26, 0.04, x, 0.42 + k * 0.816, PROF / 2 - 0.13, Color3.fromRGB(255, 120, 40), Enum.Material.Neon, porte).CastShadow = false
			end
		end
		if k == 0 then porte.PrimaryPart = pan end
	end
	porte.Parent = d
	bloc("Brasier", 10.6, 5.2, 0.2, 0, 2.6, PROF / 2 + 1.5, Color3.fromRGB(190, 46, 14), Enum.Material.Neon).CastShadow = false
	for k = 0, 19 do
		local f = bloc("Flamme", 0.5, 1, 0.14, -4.75 + k * 0.5, 1, PROF / 2 + 1.3,
			(k % 3 == 0) and Color3.fromRGB(255, 190, 60) or Color3.fromRGB(255, 110, 30), Enum.Material.Neon)
		f.CastShadow = false
		table.insert(flammes, f)
	end
	local _, fp = lampe("FeuPorte", 0, 2.2, PROF / 2 - 1.5, Color3.fromRGB(255, 130, 50), 0, 60, true)
	feuPorte = fp

	-- ── LE PLATEAU : un disque de fer cerclé de cyan, douze plots, un cercle intérieur ──
	plateau = Instance.new("Model")
	plateau.Name = "Plateau"
	local anneau = cyl("Anneau", 4.47, 0.10, 0, 0.05, 0, CYAN, Enum.Material.Neon, plateau)
	anneau.CastShadow = false
	local disque = cyl("Disque", 4.38, 0.12, 0, 0.06, 0, Color3.fromRGB(40, 44, 66), nil, plateau)
	disque.Reflectance = 0.2
	cyl("Cercle", 3.22, 0.122, 0, 0.061, 0, Color3.fromRGB(40, 150, 170), Enum.Material.Neon, plateau).CastShadow = false
	cyl("Coeur", 3.18, 0.124, 0, 0.062, 0, Color3.fromRGB(34, 38, 58), nil, plateau).Reflectance = 0.2
	for k = 0, 11 do
		local a = k / 12 * math.pi * 2
		bloc("Plot", 0.16, 0.03, 0.16, math.cos(a) * 4.05, 0.13, math.sin(a) * 4.05, CYAN, Enum.Material.Neon, plateau).CastShadow = false
	end
	plateau.PrimaryPart = disque
	plateau.Parent = d
	-- le halo cyan qui lèche le sol autour du plateau
	for k = 0, 2 do
		local a = k / 3 * math.pi * 2 + 0.5
		lampe("HaloPlateau", math.cos(a) * 5.4, 0.5, math.sin(a) * 5.4, CYAN, 0.3, 18)
	end
	-- le SCANNER du retourneur (un disque de lumière qui monte quand on change de caisse)
	scanner = cyl("Scanner", 3.0, 0.04, 0, 0.2, 0, CYAN, Enum.Material.Neon)
	scanner.Transparency = 1
	scanner.CastShadow = false

	-- ── le BAZAR (tout ce qui est haut reste à plus de 8,3 m du centre : la vue ne le traverse jamais) ──
	-- le distributeur rouge
	bloc("Distributeur", 0.9, 2.1, 1.2, 10.3, 1.05, 6.4, Color3.fromRGB(214, 40, 52))
	bloc("Vitrine", 0.05, 1.2, 0.8, 9.83, 1.3, 6.4, Color3.fromRGB(255, 120, 140), Enum.Material.Neon).CastShadow = false
	for k = 0, 2 do
		bloc("Canette", 0.06, 0.16, 0.7, 9.8, 0.95 + k * 0.36, 6.4, ({ Color3.fromRGB(90, 220, 255), Color3.fromRGB(255, 215, 94), Color3.fromRGB(120, 255, 150) })[k + 1], Enum.Material.Neon).CastShadow = false
	end
	-- l'affiche « RECORD PERSO » dans son cadre d'or
	bloc("CadreAffiche", 1.7, 2.5, 0.08, 7.4, 2.5, PROF / 2 - 0.05, Color3.fromRGB(255, 200, 60)).Reflectance = 0.3
	local aff = bloc("Affiche", 1.46, 2.26, 0.04, 7.4, 2.5, PROF / 2 - 0.11, Color3.fromRGB(58, 30, 112))
	ecriteau(aff, Enum.NormalId.Front, FR and "RECORD\nPERSO" or "PERSONAL\nBEST", Color3.fromRGB(255, 215, 94), 16)
	-- les piles de pneus
	for _, q in { { 8.9, 9.6, 3 }, { 9.7, 8.7, 2 }, { -9.6, -5.2, 4 }, { 9.6, -8.4, 3 } } do
		for k = 0, q[3] - 1 do
			cyl("Pneu", 0.42, 0.26, q[1], 0.13 + k * 0.27, q[2], Color3.fromRGB(20, 20, 26))
			cyl("Jante", 0.2, 0.27, q[1], 0.13 + k * 0.27, q[2], Color3.fromRGB(110, 116, 140), Enum.Material.Metal)
		end
	end
	-- les plots de chantier (sous 50 cm : ils ont le droit d'être près)
	for _, q in { { 6.3, 9.4 }, { 5.4, 10.6 }, { 7.3, 10.2 }, { -6.9, 6.6 } } do
		bloc("PlotBase", 0.42, 0.05, 0.42, q[1], 0.025, q[2], Color3.fromRGB(255, 110, 30))
		bloc("PlotBas", 0.28, 0.2, 0.28, q[1], 0.15, q[2], Color3.fromRGB(255, 110, 30))
		bloc("PlotBande", 0.21, 0.1, 0.21, q[1], 0.3, q[2], Color3.fromRGB(245, 245, 250))
		bloc("PlotHaut", 0.14, 0.14, 0.14, q[1], 0.42, q[2], Color3.fromRGB(255, 110, 30))
	end
	-- l'établi, son panneau d'outils, la servante
	bloc("Etabli", 0.9, 0.1, 3.4, -10.3, 0.9, 2.2, Color3.fromRGB(150, 100, 60), Enum.Material.Wood)
	bloc("EtabliCorps", 0.8, 0.85, 3.2, -10.35, 0.42, 2.2, Color3.fromRGB(46, 60, 110))
	bloc("PanneauOutils", 0.06, 1.5, 3.2, -10.9, 2.2, 2.2, Color3.fromRGB(70, 76, 108))
	for k, c in { Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 215, 94), Color3.fromRGB(90, 220, 255), Color3.fromRGB(190, 200, 220), Color3.fromRGB(120, 255, 150) } do
		bloc("Outil", 0.05, 0.6 - (k % 2) * 0.2, 0.12, -10.84, 2.2 + (k % 2) * 0.2, 0.9 + k * 0.45, c)
	end
	bloc("Servante", 0.7, 0.9, 1.0, -10.2, 0.5, -1.2, Color3.fromRGB(220, 44, 60))
	-- le rack et ses caisses
	for k = 0, 3 do
		bloc("Etagere", 0.9, 0.06, 4.2, -10.4, 0.5 + k * 0.95, -8.2, ACIER, Enum.Material.Metal)
		for j = 0, 3 do
			local c = ({ Color3.fromRGB(70, 110, 230), Color3.fromRGB(150, 90, 230), Color3.fromRGB(240, 170, 60), Color3.fromRGB(60, 190, 200) })[(k + j) % 4 + 1]
			if (k * 3 + j) % 5 ~= 0 then bloc("Carton", 0.7, 0.5, 0.8, -10.4, 0.78 + k * 0.95, -9.8 + j * 1.05, c) end
		end
	end
	for _, z in { -10.2, -6.2 } do bloc("RackPied", 0.08, 3.6, 0.08, -10.0, 1.8, z, ACIER, Enum.Material.Metal) end
	-- les bidons bleus et le compresseur
	for _, q in { { -7.7, 11.2 }, { -8.5, 10.5 }, { -8.6, 11.5 } } do
		cyl("Bidon", 0.3, 0.9, q[1], 0.45, q[2], Color3.fromRGB(50, 96, 226))
	end
	bloc("Compresseur", 0.8, 0.7, 1.5, 10.2, 0.55, -3.2, Color3.fromRGB(240, 120, 40))
	bloc("CompresseurPied", 0.7, 0.2, 1.3, 10.2, 0.1, -3.2, Color3.fromRGB(30, 30, 40))
	-- le socle des MISSIONS : un fût, deux joncs verts, la cible qui tourne
	cyl("Fut", 0.46, 1.0, -6.1, 0.5, 9.0, Color3.fromRGB(44, 50, 70))
	cyl("Jonc", 0.48, 0.07, -6.1, 0.3, 9.0, Color3.fromRGB(94, 227, 122), Enum.Material.Neon).CastShadow = false
	cyl("Jonc", 0.48, 0.07, -6.1, 0.82, 9.0, Color3.fromRGB(94, 227, 122), Enum.Material.Neon).CastShadow = false
	cible = Instance.new("Model")
	cible.Name = "Cible"
	for k, q in { { 0.5, Color3.fromRGB(94, 227, 122), 0.04 }, { 0.36, Color3.fromRGB(20, 40, 30), 0.05 }, { 0.2, Color3.fromRGB(94, 227, 122), 0.06 } } do
		local c = cyl("Disque" .. k, q[1], q[3], -6.1, 1.75, 9.0, q[2], Enum.Material.Neon, cible)
		c.CFrame = CFrame.new(P(-6.1, 1.75, 9.0)) * CFrame.Angles(0, math.pi / 2, 0)
		c.CastShadow = false
		if k == 1 then cible.PrimaryPart = c end
	end
	cible.Parent = d
	lampe("LueurCible", -6.1, 1.7, 8.2, Color3.fromRGB(94, 227, 122), 0.8, 14)
	-- la guirlande d'ampoules, tendue devant la porte
	local tons = { Color3.fromRGB(255, 90, 200), CYAN, Color3.fromRGB(255, 215, 94), Color3.fromRGB(120, 255, 150) }
	for k = 0, 17 do
		local u = k / 17
		local b = bloc("Ampoule", 0.13, 0.13, 0.13, -10.4 + u * 20.8, 5.45 - 0.7 * (1 - (2 * u - 1) ^ 2), PROF / 2 - 1.4, tons[k % 4 + 1], Enum.Material.Neon)
		b.Shape = Enum.PartType.Ball
		b.CastShadow = false
	end
	-- les deux lampes de studio : elles suivent la vue (la clé chaude, la rive cyan)
	lampeCle = lampe("Cle", 0, 4.1, -5.2, Color3.fromRGB(255, 220, 168), 1.0, 60, true)
	lampeRive = lampe("Rive", 0, 2.3, 6, CYAN, 0.45, 52)
end

-- l'ambiance : dedans, le soleil du niveau n'existe pas. On éteint le dehors le temps de la visite (côté joueur seulement).
local sauve: any = nil
local function ambiance(on: boolean)
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
	if on then
		if sauve then return end
		sauve = { b = Lighting.Brightness, a = Lighting.Ambient, o = Lighting.OutdoorAmbient, e = Lighting.ExposureCompensation,
			d = Lighting.EnvironmentDiffuseScale, s = Lighting.EnvironmentSpecularScale, dens = atm and atm.Density, r = rays and rays.Enabled }
		Lighting.Brightness = 0
		Lighting.Ambient = Color3.fromRGB(46, 44, 84)
		Lighting.OutdoorAmbient = Color3.fromRGB(46, 44, 84)
		Lighting.ExposureCompensation = -0.25
		Lighting.EnvironmentDiffuseScale = 0.12
		Lighting.EnvironmentSpecularScale = 0.25
		if atm then atm.Density = 0 end
		if rays then rays.Enabled = false end
	elseif sauve then
		Lighting.Brightness = sauve.b
		Lighting.Ambient = sauve.a
		Lighting.OutdoorAmbient = sauve.o
		Lighting.ExposureCompensation = sauve.e
		Lighting.EnvironmentDiffuseScale = sauve.d
		Lighting.EnvironmentSpecularScale = sauve.s
		if atm and sauve.dens then atm.Density = sauve.dens end
		if rays and sauve.r ~= nil then rays.Enabled = sauve.r end
		sauve = nil
	end
end

-- ════════════════════════════════════════════════════════════════════════════════════════════════
-- L'INTERFACE
-- ════════════════════════════════════════════════════════════════════════════════════════════════
local U: any = {}
local CASH = Color3.fromRGB(125, 255, 155)
local OR1 = Color3.fromRGB(255, 226, 122)
local ROUGE = Color3.fromRGB(255, 74, 100)
local ENCRE_OR = Color3.fromRGB(58, 24, 0)
local W_CONSOLE, H_CONSOLE = 470, 322

-- une PLAQUE de la barre d'action : un cadre (qu'on place) et un fond (qui s'enfonce)
local STYLES = {
	or_ = { ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 250, 223)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 208, 68)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(234, 147, 10)) }), C.orSh, ENCRE_OR },
	laque = { ColorSequence.new(Color3.fromRGB(39, 32, 73), Color3.fromRGB(20, 16, 41)), C.trait, C.texte },
	verrou = { ColorSequence.new(Color3.fromRGB(22, 20, 38), Color3.fromRGB(14, 12, 26)), Color3.fromRGB(40, 36, 66), C.terne },
}
local function plaque(parent: Instance, nom: string): any
	local cadre = inst("Frame", { Name = nom, BackgroundTransparency = 1 }, parent)
	local tranche = inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(10, 8, 24), Size = UDim2.new(1, 0, 1, 0), Position = UDim2.fromOffset(0, 5) }, cadre)
	local fond = inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromScale(1, 1) }, cadre)
	local grad = inst("UIGradient", { Rotation = 90 }, fond)
	local trait = inst("UIStroke", { Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, fond)
	local filet = inst("Frame", { BorderSizePixel = 0, Size = UDim2.new(0, 4, 1, 0) }, fond)
	local l1 = inst("TextLabel", { BackgroundTransparency = 1, FontFace = K.PIX, Size = UDim2.new(1, -10, 0, 16), Position = UDim2.fromOffset(5, 8),
		TextSize = 10, Text = "" }, fond)
	local l2 = inst("TextLabel", { BackgroundTransparency = 1, FontFace = K.PIX, Size = UDim2.new(1, -10, 1, 0), Position = UDim2.fromOffset(5, 0),
		TextSize = 16, Text = "" }, fond)
	local b = inst("TextButton", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 5), Text = "", AutoButtonColor = false, ZIndex = 4 }, cadre)
	local pq = { cadre = cadre, fond = fond, grad = grad, trait = trait, filet = filet, l1 = l1, l2 = l2, b = b, tranche = tranche, enfonce = false }
	local function pose(bas: boolean)
		TweenService:Create(fond, K.RAPIDE, { Position = UDim2.fromOffset(0, (bas or pq.enfonce) and 5 or 0) }):Play()
	end
	b.MouseButton1Down:Connect(function() pose(true) end)
	b.MouseButton1Up:Connect(function() pose(false) end)
	b.MouseLeave:Connect(function() pose(false) end)
	b.Activated:Connect(function() Sons.jouer("tap") end)
	return pq
end
-- style : "or_" | "laque" | "verrou" ; filet = la couleur du liseré gauche (laque) ; l1 petite ligne, l2 grande
local function habiller(pq: any, style: string, filet: Color3?, l1: string?, l2: string, corps: number?, couleur2: Color3?)
	local s = STYLES[style]
	pq.grad.Color = s[1]
	pq.trait.Color = (style == "laque" and filet == ROUGE) and ROUGE or s[2]
	pq.filet.Visible = style == "laque" and filet ~= nil
	if filet then pq.filet.BackgroundColor3 = filet end
	pq.l1.Text = l1 or ""
	pq.l1.TextColor3 = s[3]
	pq.l2.Text = l2
	pq.l2.TextColor3 = couleur2 or s[3]
	pq.l2.TextSize = corps or 16
	pq.l2.Position = UDim2.fromOffset(5, l1 and 9 or 0)
	pq.enfonce = style == "verrou"
	pq.fond.Position = UDim2.fromOffset(0, pq.enfonce and 5 or 0)
end

local tuiles: { [number]: any } = {}
local fileN = 0 -- le numéro de la file de photos en cours (changer de famille l'annule)

-- LA PHOTO d'une caisse (carPhoto du web) : trois-quarts avant, nez à gauche, objectif de 24°
local function photographier(t: any, i: number)
	local m = Caisse.vignette(i)
	if not m then return end
	if not t.cadre.Parent then
		m:Destroy()
		return
	end
	local corps = m.PrimaryPart :: BasePart
	local az, el = 0.82, 0.27
	local dir = Vector3.new(-math.sin(az) * math.cos(el), math.sin(el), -math.cos(az) * math.cos(el))
	local projete = corps.Size.Z * math.sin(az) + corps.Size.X * math.cos(az)
	local dist = projete / 0.9 / (2 * math.tan(math.rad(12)) * (104 / 54)) + corps.Size.Z * 0.18
	local cam = Instance.new("Camera")
	cam.FieldOfView = 24
	local vise = corps.Position + Vector3.new(0, -corps.Size.Y * 0.04, 0)
	cam.CFrame = CFrame.lookAt(vise + dir * dist, vise)
	cam.Parent = t.vp
	t.vp.CurrentCamera = cam
	t.vp.LightDirection = (-dir * 0.5 + Vector3.new(0.5, -1, 0.2)).Unit
	m.Parent = t.vp
	t.pastille.Visible = false
	t.modele = m
end

local function majTuile(i: number)
	local t = tuiles[i]
	if not t then return end
	local f = Catalogue[i]
	local aMoi = possede(i)
	local equipee = profil().caisse == i
	local sombre = not aMoi and f.cond.k ~= "depart"
	t.vp.ImageColor3 = sombre and Color3.fromRGB(120, 112, 150) or Color3.new(1, 1, 1)
	t.verrou.Visible = sombre
	t.losange.Visible = equipee
	local etiquette, couleur = "", CASH
	if sombre then
		if f.cond.k == "prix" then etiquette = Hud.argent(f.cond.v)
		elseif f.cond.k == "premium" then etiquette, couleur = eurTexte(f.cond.eur), OR1 end
	elseif not equipee then
		etiquette = "✓"
	end
	t.prix.Text = etiquette
	t.prix.TextColor3 = couleur
	t.trait.Enabled = i == montre
	t.cadre.BackgroundColor3 = i == montre and Color3.fromRGB(52, 44, 96) or Color3.fromRGB(26, 22, 50)
end

local function creerTuile(i: number, rang: number): any
	local f = Catalogue[i]
	local c = COULEUR_RAR[f.rar]
	local cadre = inst("Frame", { Name = "T" .. i, BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(26, 22, 50), LayoutOrder = rang, ClipsDescendants = true }, U.bande)
	local trait = inst("UIStroke", { Color = c, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Enabled = false }, cadre)
	local vp = inst("ViewportFrame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Ambient = Color3.fromRGB(150, 150, 178),
		LightColor = Color3.fromRGB(255, 244, 230) }, cadre)
	-- en attendant la photo : une pastille à la couleur de sa laque
	local pastille = inst("Frame", { BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(44, 12), BackgroundColor3 = Color3.fromHex(string.format("%06x", f.laque)) }, cadre)
	inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = c, Size = UDim2.new(1, 0, 0, 3), Position = UDim2.new(0, 0, 1, -3), ZIndex = 2 }, cadre)
	local prix = inst("TextLabel", { BackgroundTransparency = 1, FontFace = K.PIX, TextSize = 9, Text = "", TextColor3 = CASH,
		Size = UDim2.new(1, -6, 0, 12), Position = UDim2.new(0, 0, 1, -17), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3 }, cadre)
	inst("UIStroke", { Color = C.encre, Thickness = 2 }, prix)
	local verrou = inst("TextLabel", { BackgroundTransparency = 1, Text = "🔒", TextSize = 10, Size = UDim2.fromOffset(14, 14),
		Position = UDim2.fromOffset(4, 3), ZIndex = 3, Visible = false }, cadre)
	local losange = inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(255, 199, 42), Size = UDim2.fromOffset(9, 9),
		Position = UDim2.fromOffset(7, 6), Rotation = 45, ZIndex = 3, Visible = false }, cadre)
	local b = inst("TextButton", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = "", ZIndex = 5 }, cadre)
	local t = { cadre = cadre, trait = trait, vp = vp, pastille = pastille, prix = prix, verrou = verrou, losange = losange, b = b }
	b.Activated:Connect(function()
		Sons.jouer("tap")
		Garage.sauter(i)
	end)
	return t
end

-- la bande ne montre que la famille courante ; les photos se prennent une par une (la partie coûteuse)
local function majBande()
	fileN += 1
	local n = fileN
	local liste = FAMILLES[famille]
	local garde: { [number]: boolean } = {}
	for _, i in liste do garde[i] = true end
	for i, t in tuiles do
		if not garde[i] then
			t.cadre:Destroy()
			tuiles[i] = nil
		end
	end
	for rang, i in liste do
		if not tuiles[i] then tuiles[i] = creerTuile(i, rang) end
		majTuile(i)
	end
	U.bande.CanvasPosition = Vector2.zero
	task.spawn(function()
		for _, i in liste do
			if n ~= fileN or not Garage.ouvert then return end
			local t = tuiles[i]
			if t and not t.modele and not t.enCours then
				t.enCours = true
				photographier(t, i)
				task.wait()
			end
		end
	end)
end

local function majPastilles()
	for _, r in RARETES do
		local p = U.pastilles[r.id]
		local a, n = 0, 0
		for _, i in FAMILLES[r.id] do
			n += 1
			if possede(i) or Catalogue[i].cond.k == "depart" then a += 1 end
		end
		p.txt.Text = a .. "/" .. n
		local actif = r.id == famille
		p.fond.BackgroundColor3 = actif and r.c:Lerp(Color3.fromRGB(20, 16, 41), 0.72) or Color3.fromRGB(20, 16, 41)
		p.trait.Color = actif and r.c or C.trait
		p.txt.TextColor3 = actif and C.texte or C.texte2
	end
end

-- le COMPTE : il roule jusqu'à sa nouvelle valeur (900 ms)
local compteVu, compteN = 0, 0
local function majCompte(direct: boolean?)
	local cibleV = profil().compte or 0
	if direct or cibleV == compteVu then
		compteVu = cibleV
		U.compte.Text = Hud.compte(cibleV)
		return
	end
	compteN += 1
	local n, de = compteN, compteVu
	compteVu = cibleV
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < 0.9 and n == compteN do
			local u = (os.clock() - t0) / 0.9
			U.compte.Text = Hud.compte(de + (cibleV - de) * (1 - (1 - u) ^ 3))
			task.wait()
		end
		if n == compteN then U.compte.Text = Hud.compte(cibleV) end
	end)
end

-- ce qu'il reste à faire pour une caisse fermée (carUnlockText)
local function condition(i: number): string
	local k = Catalogue[i].cond
	if k.k == "carnet" then return L.carnet end
	if k.k == "carrN" then return string.format(L.carrN, 0) end
	if k.k == "carrV" then return string.format(L.carrV, 0) end
	if k.k == "aura" then return string.format(L.aura, L.rangs[k.v + 1] or "?", L.rangs[rangAura(profil().aura or 0)]) end
	if k.k == "premium" then return L.boutique .. " — " .. eurTexte(k.eur) end
	return ""
end

-- LA DÉCISION (gEtat + gPrixHtml + gActSync) : quel bouton, en or ou non
local decision = "" -- "" | acheter | pauvre | equiper | verrou | boutique
local function majFiche()
	local f = Catalogue[montre]
	local c = COULEUR_RAR[f.rar]
	local nom = FR and f.nom or (f.en or f.nom)
	nom = string.upper(nom)
	U.nom.Text = nom
	U.nom.TextSize = math.clamp(math.floor(470 / math.max(8, utf8.len(nom) or #nom)), 16, 34)
	U.barre.BackgroundColor3 = c
	U.rang.Text = RANG[montre] .. " / " .. #LISTE
	local k = f.cond
	local aMoi, ouv = gagnee(montre), ouverte(montre)
	local test = ouv and not aMoi
	-- la fiche n'écrit que la condition d'une caisse fermée (le prix, lui, est sur le bouton et la vignette)
	local desc = ""
	if not aMoi and k.k ~= "prix" then desc = "🔒 " .. condition(montre) end
	if test then desc = '<font color="#ffd75e">[TEST]</font> ' .. desc end
	U.desc.Text = desc
	-- le bouton
	local compte = profil().compte or 0
	if k.k == "prix" and not possede(montre) then
		decision = compte >= k.v and "acheter" or "pauvre"
	elseif k.k == "premium" and not possede(montre) and not ouv then
		decision = "boutique"
	elseif not ouv then
		decision = "verrou"
	elseif profil().caisse ~= montre then
		decision = "equiper"
	else
		decision = ""
	end
	local choix = decision ~= ""
	local x = 14
	local function placer(pq: any, l: number, visible: boolean)
		pq.cadre.Visible = visible
		if not visible then return end
		pq.cadre.Position = UDim2.fromOffset(x, 246)
		pq.cadre.Size = UDim2.fromOffset(l, 58)
		x += l + 8
	end
	local reste = W_CONSOLE - 28
	if choix then
		placer(U.btHome, 52, true)
		placer(U.btBoutique, 52, true)
		reste -= (52 + 8) * 2
		local lDec = math.floor((reste - 8) * 0.56)
		placer(U.btDecision, lDec, true)
		placer(U.btJouer, reste - 8 - lDec, true)
		habiller(U.btHome, "laque", C.lavande, nil, "⌂", 22)
		habiller(U.btBoutique, "laque", C.magenta, nil, "$", 18)
		habiller(U.btJouer, "laque", C.cyan, nil, L.jouer, 15)
		if decision == "acheter" then
			habiller(U.btDecision, "or_", nil, L.acheter, Hud.argent(k.v), 17)
		elseif decision == "pauvre" then
			habiller(U.btDecision, "laque", ROUGE, L.manque, Hud.argent(k.v - compte), 15, ROUGE)
		elseif decision == "equiper" then
			habiller(U.btDecision, "or_", nil, nil, L.equiper, 18)
		elseif decision == "boutique" then
			habiller(U.btDecision, "or_", nil, L.enBoutique, eurTexte(k.eur), 16)
		else
			habiller(U.btDecision, "verrou", nil, nil, "🔒 " .. L.verrou, 11)
		end
	else
		placer(U.btHome, 76, true)
		placer(U.btBoutique, 86, true)
		placer(U.btDecision, 0, false)
		placer(U.btJouer, reste - 76 - 86 - 16, true)
		habiller(U.btHome, "laque", C.lavande, "⌂", L.home, 10)
		habiller(U.btBoutique, "laque", C.magenta, "$", L.boutique, 9)
		habiller(U.btJouer, "or_", nil, nil, L.jouer, 30)
	end
end

local function majTout()
	majCompte()
	majPastilles()
	for i in tuiles do majTuile(i) end
	majFiche()
end

local function secouer()
	local p0 = UDim2.new(1, -22, 1, -16)
	task.spawn(function()
		for k = 1, 6 do
			U.console.Position = p0 + UDim2.fromOffset((k % 2 == 0 and 1 or -1) * (7 - k), 0)
			task.wait(0.05)
		end
		U.console.Position = p0
	end)
end

-- l'achat se FÊTE : le tampon d'or « À TOI ! » et un éclair à la couleur de la caisse
local function tampon(couleur: Color3)
	U.tampon.Visible = true
	U.tampon.TextTransparency = 0
	U.tamponEchelle.Scale = 2.4
	TweenService:Create(U.tamponEchelle, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	U.eclat.BackgroundColor3 = couleur
	U.eclat.BackgroundTransparency = 0.35
	TweenService:Create(U.eclat, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
	task.delay(1.5, function()
		TweenService:Create(U.tampon, K.LENTE, { TextTransparency = 1 }):Play()
		task.wait(0.4)
		U.tampon.Visible = false
	end)
end

local arme = 0 -- après un achat, ÉQUIPER prend la place d'ACHETER : le 2e appui d'un double appui ne doit pas l'activer
local occupe = false
local function decider()
	if occupe or os.clock() < arme then return end
	local f = Catalogue[montre]
	if decision == "acheter" then
		occupe = true
		local ok = ctx.action("acheter", montre)
		occupe = false
		if ok then
			arme = os.clock() + 0.42
			Sons.jouer("encaisse")
			tampon(COULEUR_RAR[f.rar])
			majTout()
		else
			secouer()
		end
	elseif decision == "pauvre" then
		secouer()
		Hud.toast("✗ " .. L.ilTeManque .. Hud.argent(f.cond.v - (profil().compte or 0)), ROUGE)
	elseif decision == "equiper" then
		occupe = true
		local ok = ctx.action("equiper", montre)
		occupe = false
		if ok then
			Sons.jouer("maillon")
			ctx.surEquipe(montre)
			majTout()
		else
			secouer()
		end
	elseif decision == "verrou" then
		secouer()
		Hud.toast("🔒 " .. condition(montre))
	elseif decision == "boutique" then
		Hud.toast("🛒 " .. L.bientot)
	end
end

local function creerInterface()
	local racine = Hud.racine
	local g = inst("Frame", { Name = "Garage", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, racine)
	U.racine = g
	-- les voiles : le haut et la droite s'assombrissent pour que le texte se lise (rien de flou : charte)
	local vh = inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(7, 5, 15), Size = UDim2.new(1, 0, 0, 190) }, g)
	inst("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.15, 1) }, vh)
	local vd = inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(7, 5, 15), Size = UDim2.new(0, 620, 1, 0), Position = UDim2.fromScale(1, 0),
		AnchorPoint = Vector2.new(1, 0) }, g)
	inst("UIGradient", { Rotation = 0, Transparency = NumberSequence.new(1, 0.3) }, vd)
	U.eclat = inst("Frame", { BorderSizePixel = 0, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, g)

	-- ── le COMPTE ──
	local cp = K.carbone(g, UDim2.fromOffset(250, 42), UDim2.fromOffset(22, 16))
	inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = CASH, Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2) }, cp)
	local piece = inst("TextLabel", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(255, 199, 42), Size = UDim2.fromOffset(24, 24),
		Position = UDim2.fromOffset(10, 8), FontFace = K.PIX, Text = "$", TextSize = 14, TextColor3 = ENCRE_OR }, cp)
	inst("UIStroke", { Color = C.orSh, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, piece)
	U.compte = K.texte(cp, { Text = "$ 0", TextSize = 18, TextColor3 = CASH, Size = UDim2.new(1, -52, 1, 0), Position = UDim2.fromOffset(44, 0),
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = false, contourCouleur = Color3.fromRGB(5, 36, 15) })
	U.compteCadre = cp

	-- ── la FICHE : nom, barre de rareté, rang, condition ──
	U.nom = K.texte(g, { Text = "", TextSize = 34, TextColor3 = C.texte, Size = UDim2.fromOffset(500, 44), Position = UDim2.fromOffset(26, 72),
		TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = false, epais = 3 })
	U.barre = inst("Frame", { BorderSizePixel = 0, Size = UDim2.fromOffset(330, 4), Position = UDim2.fromOffset(24, 122) }, g)
	U.rang = K.texte(g, { Text = "", TextSize = 11, TextColor3 = C.terne, Size = UDim2.fromOffset(300, 16), Position = UDim2.fromOffset(26, 134),
		TextXAlignment = Enum.TextXAlignment.Left })
	U.desc = K.texte(g, { Text = "", RichText = true, TextSize = 11, TextColor3 = C.texte2, Size = UDim2.fromOffset(440, 70), Position = UDim2.fromOffset(26, 158),
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, LineHeight = 1.4 })
	U.tampon = K.texte(g, { Text = L.aToi, TextSize = 54, TextColor3 = Color3.fromRGB(255, 215, 94), Size = UDim2.fromOffset(520, 80),
		Position = UDim2.new(0.3, 0, 0.42, 0), AnchorPoint = Vector2.new(0.5, 0.5), Rotation = -9, Visible = false, epais = 5,
		contourCouleur = Color3.fromRGB(70, 30, 0), ZIndex = 20 })
	U.tamponEchelle = inst("UIScale", {}, U.tampon)

	-- ── ⚙ ──
	U.btReglages = K.tuile(g, "⚙", C.cyan, UDim2.fromOffset(52, 44), UDim2.new(1, -22, 0, 14), Vector2.new(1, 0), 22)

	-- ── LA CONSOLE ──
	local cs = K.carbone(g, UDim2.fromOffset(W_CONSOLE, H_CONSOLE), UDim2.new(1, -22, 1, -16), nil, Vector2.new(1, 1))
	cs.Active = true -- un glissé qui commence sur la console ne fait pas tourner la caisse
	U.console = cs
	for k, c in { C.magenta, C.cyan, C.or_ } do -- la livrée, en liseré
		inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = c, Size = UDim2.new(k == 1 and 0.44 or 0.25, -6, 0, 3),
			Position = UDim2.new(k == 1 and 0 or (k == 2 and 0.46 or 0.73), 0, 0, -3) }, cs)
	end
	-- les onglets
	U.onglets = {}
	local lo = (W_CONSOLE - 28 - 12) / 4
	for k, o in { { "voiture", L.voitures }, { "peinture", L.peinture }, { "aile", L.ailes }, { "trainee", L.trainees } } do
		local f = inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), Size = UDim2.fromOffset(lo, 46),
			Position = UDim2.fromOffset(14 + (k - 1) * (lo + 4), 14) }, cs)
		local grad = inst("UIGradient", { Rotation = 90 }, f)
		local b = inst("TextButton", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), FontFace = K.PIX, Text = o[2], TextSize = 9,
			AutoButtonColor = false }, f)
		U.onglets[o[1]] = { f = f, grad = grad, b = b }
		b.Activated:Connect(function()
			Sons.jouer("tap")
			if o[1] ~= "voiture" then
				Hud.toast(L.bientot)
				return
			end
			onglet = o[1]
			Garage.majOnglets()
		end)
	end
	-- les pastilles de famille
	U.pastilles = {}
	local lp = (W_CONSOLE - 28 - 16) / 5
	for k, r in RARETES do
		local f = inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(20, 16, 41), Size = UDim2.fromOffset(lp, 34),
			Position = UDim2.fromOffset(14 + (k - 1) * (lp + 4), 70) }, cs)
		local trait = inst("UIStroke", { Color = C.trait, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
		inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = r.c, Size = UDim2.fromOffset(9, 9), Position = UDim2.new(0, 12, 0.5, 0),
			AnchorPoint = Vector2.new(0.5, 0.5), Rotation = 45 }, f)
		inst("Frame", { BorderSizePixel = 0, BackgroundColor3 = r.c, Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2) }, f)
		local txt = inst("TextLabel", { BackgroundTransparency = 1, FontFace = K.PIX, Text = "", TextSize = 9, TextColor3 = C.texte2,
			Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(22, 0) }, f)
		local b = inst("TextButton", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 10), Position = UDim2.fromOffset(0, -5), Text = "" }, f)
		U.pastilles[r.id] = { fond = f, trait = trait, txt = txt }
		b.Activated:Connect(function()
			Sons.jouer("tap")
			-- la pastille saute à la caisse équipée si elle est de la famille, sinon à la première
			local eq = profil().caisse
			local vers = (Catalogue[eq] and Catalogue[eq].rar == r.id) and eq or FAMILLES[r.id][1]
			if vers then Garage.sauter(vers) end
		end)
	end
	-- la bande de vignettes : deux rangées, on fait défiler
	U.bande = inst("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromOffset(W_CONSOLE - 28, 122),
		Position = UDim2.fromOffset(14, 114), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.X,
		ScrollingDirection = Enum.ScrollingDirection.X, ScrollBarThickness = 4, ScrollBarImageColor3 = C.terne,
		VerticalScrollBarInset = Enum.ScrollBarInset.None }, cs)
	inst("UIGridLayout", { CellSize = UDim2.fromOffset(104, 54), CellPadding = UDim2.fromOffset(6, 6), FillDirection = Enum.FillDirection.Vertical,
		FillDirectionMaxCells = 2, SortOrder = Enum.SortOrder.LayoutOrder }, U.bande)
	inst("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingLeft = UDim.new(0, 2) }, U.bande)
	-- la barre d'action
	U.btHome = plaque(cs, "Home")
	U.btBoutique = plaque(cs, "Boutique")
	U.btDecision = plaque(cs, "Decision")
	U.btJouer = plaque(cs, "Jouer")
	U.btHome.b.Activated:Connect(function() if not Garage.lance then ctx.surHome() end end)
	U.btBoutique.b.Activated:Connect(function() Hud.toast("🛒 " .. L.bientot) end)
	U.btDecision.b.Activated:Connect(decider)
	U.btJouer.b.Activated:Connect(function() Garage.jouer() end)
	U.btReglages.Activated:Connect(function() if not Garage.lance then ctx.surReglages() end end)

	-- le fondu blanc chaud du lâcher (il survit à la fermeture du garage)
	U.fondu = inst("Frame", { Name = "FonduGarage", BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(255, 227, 184), BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1), ZIndex = 70, Visible = false }, racine)
end

function Garage.majOnglets()
	for id, o in U.onglets do
		local actif = id == onglet
		o.grad.Color = actif and ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 114, 217)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(224, 36, 157)), ColorSequenceKeypoint.new(1, Color3.fromRGB(192, 21, 133)) })
			or ColorSequence.new(Color3.fromRGB(30, 25, 58), Color3.fromRGB(18, 14, 36))
		o.b.TextColor3 = actif and C.texte or C.terne
	end
end

-- ════════════════════════════════════════════════════════════════════════════════════════════════
-- LE PLATEAU, LE RETOURNEUR, LA VUE
-- ════════════════════════════════════════════════════════════════════════════════════════════════
local ang = 0            -- l'angle du plateau (0 = la caisse nous tourne le dos, nez vers la porte)
local pitch, dist = 0.2, 7.8
local bascule: any = nil -- { t, pret = { m }, fait }
local jeton = 0
local glisse: any = nil  -- le doigt / la souris qui fait tourner
local touche = 0         -- l'heure du dernier geste (la vue se balance quand on ne touche à rien)
local lacher: any = nil  -- le LÂCHER : { t }
local echelleVue = 1

local function cfPlateau(): CFrame
	return CFrame.new(P(0, POD, 0)) * CFrame.Angles(0, math.pi + ang, 0)
end
local function poserCaisse(m: Model, echelle: number, dz: number?)
	if math.abs(echelle - echelleVue) > 0.002 or echelle == 1 then
		pcall(function() m:ScaleTo(math.max(0.02, echelle)) end)
	end
	local cf = cfPlateau()
	if dz then cf = CFrame.new(0, 0, dz * M) * cf end
	m:PivotTo(cf)
end

-- changer de caisse : la caisse s'écrase dans le plateau, le scanner monte, la nouvelle se déploie
function Garage.sauter(i: number, direct: boolean?)
	if not Catalogue[i] or lacher then return end
	if i == montre and vitrine and not bascule then return end
	montre = i
	local fam = Catalogue[i].rar
	local change = fam ~= famille
	famille = fam
	if change then majBande() end
	majPastilles()
	for k in tuiles do majTuile(k) end
	majFiche()
	jeton += 1
	local n = jeton
	local b = { t = direct and 0.34 or 0, pret = nil, fait = false }
	bascule = b
	if not direct then Sons.jouer("fronde", 1.2, 0.35) end
	task.spawn(function()
		local m = Caisse.construire("Vitrine", i, true)
		if n ~= jeton or not Garage.ouvert then
			m:Destroy()
			return
		end
		b.pret = m
	end)
end
function Garage.voisin(d: number)
	local k = RANG[montre] or 1
	Garage.sauter(LISTE[(k - 1 + d) % #LISTE + 1])
end

local function lisse(u: number): number
	u = math.clamp(u, 0, 1)
	return u * u * (3 - 2 * u)
end

function Garage.rendu(dt: number)
	if not Garage.ouvert or not dossier then return end
	local cam = workspace.CurrentCamera
	local t = os.clock()
	-- ── le plateau ──
	if not glisse and not lacher then ang += 0.24 * dt end
	plateau:PivotTo(CFrame.new(P(0, 0.06, 0)) * CFrame.Angles(0, ang, 0) * CFrame.Angles(0, 0, math.pi / 2))
	cible:PivotTo(CFrame.new(P(-6.1, 1.75 + math.sin(t * 1.4) * 0.06, 9.0)) * CFrame.Angles(0, t * 0.9, 0))
	tubeMalade.Transparency = (math.noise(t * 9, 4.2) > 0.25 or math.sin(t * 37) > 0.93) and 0.75 or 0
	-- ── le retourneur ──
	local b = bascule
	if b then
		if not b.fait then
			b.t = math.min(b.t + dt, 0.34)
			local u = b.t / 0.34
			if vitrine then poserCaisse(vitrine, 1 - lisse(u) * 0.94) end
			echelleVue = 1 - lisse(u) * 0.94
			scanner.Transparency = 0.35 + 0.4 * (1 - u)
			scanner.CFrame = CFrame.new(P(0, 0.2 + u * 2.15, 0)) * CFrame.Angles(0, 0, math.pi / 2)
			if b.t >= 0.34 and b.pret then
				if vitrine then vitrine:Destroy() end
				vitrine = b.pret
				poserCaisse(b.pret, 0.06)
				echelleVue = 0.06
				b.pret.Parent = dossier
				b.fait = true
				b.t = 0
			end
		else
			b.t += dt
			local u = math.min(1, b.t / 0.72)
			-- le déploiement dépasse un peu (≈ 12 %) puis se pose
			local c1 = 2.2
			local e = 1 + (c1 + 1) * (u - 1) ^ 3 + c1 * (u - 1) ^ 2
			local ech = 0.06 + 0.94 * e
			if vitrine then poserCaisse(vitrine, u >= 1 and 1 or ech) end
			echelleVue = u >= 1 and 1 or ech
			scanner.Transparency = math.min(1, 0.35 + u * 1.4)
			scanner.CFrame = CFrame.new(P(0, 2.35 - u * 2.1, 0)) * CFrame.Angles(0, 0, math.pi / 2)
			ang += dt * 2.2 * (1 - u)
			if u >= 1 then
				bascule = nil
				scanner.Transparency = 1
			end
		end
	elseif vitrine and not lacher then
		vitrine:PivotTo(cfPlateau())
	end

	-- ── la vue ──
	local vp = cam.ViewportSize
	local aspect = vp.X / math.max(1, vp.Y)
	local fov = 52
	local posM: Vector3, viseM: Vector3
	if lacher then
		-- LE LÂCHER : la porte se lève sur le feu, la caisse s'accroupit puis fonce, la vue passe derrière elle
		lacher.t += dt
		local u = math.min(1, lacher.t / 1.7)
		local o = lisse(math.min(1, lacher.t / 0.8))
		porte:PivotTo(CFrame.new(P(0, 0.42 + o * 5.0, PROF / 2 - 0.05)))
		feuPorte.Brightness = o * 1.4
		for k, f in flammes do
			local h = 1.2 + 2.6 * math.abs(math.noise(k * 0.37, t * 3.1)) + math.sin(t * 9 + k) * 0.25
			f.Size = Vector3.new(0.5, h, 0.14) * M
			f.CFrame = CFrame.new(P(-4.75 + (k - 1) * 0.5, h / 2, PROF / 2 + 1.3))
		end
		ang += (0 - ((ang + math.pi) % (math.pi * 2) - math.pi)) * math.min(1, dt * 8) -- le nez se remet face à la porte
		local z = u * u * 17
		if vitrine then
			local accroupi = u < 0.2 and math.sin(u / 0.2 * math.pi) * 0.06 or 0
			vitrine:PivotTo(CFrame.new(0, -accroupi * M, z * M) * cfPlateau())
		end
		local k = lisse(math.min(1, u / 0.45))
		local dep = Vector3.new(0, 1.0 + dist * math.sin(pitch), -dist * math.cos(pitch))
		posM = dep:Lerp(Vector3.new(0, 1.72, z - 6.4), k)
		viseM = Vector3.new(0, 1.0, 1.5):Lerp(Vector3.new(0, 1.0, z + 4), k)
		fov = 52 + (4 + 10 * u) * k
		if u > 0.86 then
			U.fondu.Visible = true
			U.fondu.BackgroundTransparency = 1 - math.min(1, (u - 0.86) / 0.12)
		end
		if u >= 1 and not lacher.fini then
			lacher.fini = true
			local f = lacher.suite
			task.defer(f)
		end
	else
		-- au repos la vue se balance (±11° en 22 s) ; un geste la calme
		local calme = math.clamp((t - touche - 1.5) / 2, 0, 1)
		local az = math.sin(t * math.pi * 2 / 22) * 0.19 * calme
		local d = dist
		posM = Vector3.new(-math.sin(az) * d * math.cos(pitch), 1.0 + d * math.sin(pitch) + math.sin(t * 0.5) * 0.05 * calme, -math.cos(az) * d * math.cos(pitch))
		posM = Vector3.new(math.clamp(posM.X, -(LARG / 2 - 1.2), LARG / 2 - 1.2), math.clamp(posM.Y, 1.0, HAUT - 1.05),
			math.clamp(posM.Z, -(PROF / 2 - 1.2), PROF / 2 - 1.2))
		viseM = Vector3.new(math.sin(az) * 1.5, 1.0, math.cos(az) * 1.5)
	end
	-- le cadrage : la console occupe la droite, la caisse se centre dans ce qui reste (pas de décalage d'objectif chez Roblox :
	-- on tourne la tête de l'angle qui amène le plateau au milieu de la zone libre)
	local k = 0
	if not lacher or lacher.t < 0.3 then
		-- la part de l'écran que prend la console (mesurée : elle suit l'échelle de l'interface)
		local occupe9 = math.min(0.7, U.console.AbsoluteSize.X * (1 + 44 / W_CONSOLE) / math.max(1, vp.X))
		k = math.atan(occupe9 * math.tan(math.rad(fov / 2)) * aspect)
		if lacher then k *= 1 - lacher.t / 0.3 end
	end
	if cam.CameraType ~= Enum.CameraType.Scriptable then cam.CameraType = Enum.CameraType.Scriptable end
	cam.FieldOfView = fov
	cam.CFrame = CFrame.lookAt(O + posM * M, O + viseM * M) * CFrame.Angles(0, -k, 0)
	-- les deux lampes de studio suivent la vue
	lampeCle.CFrame = CFrame.new(P(-math.sin(0.72) * 5.2, 4.1, -math.cos(0.72) * 5.2))
	lampeRive.CFrame = CFrame.new(P(math.sin(0.6) * 6, 2.3, math.cos(0.6) * 6))
end

-- ════════ les gestes ════════
local function brancherGestes()
	UserInputService.InputBegan:Connect(function(io, traite)
		if not Garage.ouvert or lacher then return end
		if io.UserInputType == Enum.UserInputType.Keyboard then
			if traite then return end
			if io.KeyCode == Enum.KeyCode.Left then Garage.voisin(-1)
			elseif io.KeyCode == Enum.KeyCode.Right then Garage.voisin(1)
			elseif io.KeyCode == Enum.KeyCode.Return or io.KeyCode == Enum.KeyCode.KeypadEnter then Garage.jouer()
			elseif io.KeyCode == Enum.KeyCode.Escape or io.KeyCode == Enum.KeyCode.Backspace then ctx.surHome() end
			return
		end
		if traite or glisse then return end
		if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
			glisse = { io = io, x0 = io.Position.X, y0 = io.Position.Y, x = io.Position.X, y = io.Position.Y, t0 = os.clock(),
				souris = io.UserInputType == Enum.UserInputType.MouseButton1 }
			touche = os.clock()
		end
	end)
	UserInputService.InputChanged:Connect(function(io, traite)
		if not Garage.ouvert or lacher then return end
		if io.UserInputType == Enum.UserInputType.MouseWheel then
			if not traite then
				dist = math.clamp(dist - io.Position.Z * 0.5, 4.6, 8.6)
				touche = os.clock()
			end
			return
		end
		local g = glisse
		if not g then return end
		if (g.souris and io.UserInputType == Enum.UserInputType.MouseMovement) or io == g.io then
			local dx, dy = io.Position.X - g.x, io.Position.Y - g.y
			g.x, g.y = io.Position.X, io.Position.Y
			ang -= dx * 0.01
			pitch = math.clamp(pitch + dy * 0.006, 0.02, 0.82)
			touche = os.clock()
		end
	end)
	UserInputService.InputEnded:Connect(function(io)
		local g = glisse
		if not g then return end
		if (g.souris and io.UserInputType == Enum.UserInputType.MouseButton1) or io == g.io then
			glisse = nil
			-- un coup de pouce VIF (> 64 px, surtout horizontal) feuillette : vers la gauche = la suivante
			local dx, dy = g.x - g.x0, g.y - g.y0
			if Garage.ouvert and not lacher and os.clock() - g.t0 < 0.3 and math.abs(dx) > 64 and math.abs(dx) > 1.3 * math.abs(dy) then
				Garage.voisin(dx < 0 and 1 or -1)
			end
		end
	end)
	UserInputService.TouchPinch:Connect(function(_, echelle, _, etat, traite)
		if not Garage.ouvert or lacher or traite then return end
		if etat == Enum.UserInputState.Change then
			dist = math.clamp(dist / math.clamp(echelle, 0.96, 1.04), 4.6, 8.6)
			touche = os.clock()
		end
	end)
end

-- ════════ ouvrir, fermer, jouer ════════
function Garage.init(c: any)
	ctx = c
	creerInterface()
	brancherGestes()
end

function Garage.ouvrir(indice: number?)
	if Garage.ouvert then return end
	if not dossier then batir() end
	Garage.ouvert = true
	Garage.lance = false
	lacher = nil
	bascule = nil
	glisse = nil
	ang, pitch, dist = 0, 0.2, 7.8
	touche = 0
	porte:PivotTo(CFrame.new(P(0, 0.42, PROF / 2 - 0.05)))
	feuPorte.Brightness = 0
	scanner.Transparency = 1;
	(dossier :: Folder).Parent = workspace
	ambiance(true)
	U.racine.Visible = true
	U.fondu.Visible = false
	onglet = "voiture"
	Garage.majOnglets()
	montre = -1
	famille = ""
	majCompte(true)
	Garage.sauter(indice or profil().caisse or 0, true)
	U.racine.Position = UDim2.fromOffset(0, 18)
	TweenService:Create(U.racine, K.LENTE, { Position = UDim2.fromOffset(0, 0) }):Play()
end

function Garage.fermer()
	if not Garage.ouvert then return end
	Garage.ouvert = false
	fileN += 1
	jeton += 1
	bascule = nil
	lacher = nil
	glisse = nil
	if vitrine then
		vitrine:Destroy()
		vitrine = nil
	end
	for i, t in tuiles do
		t.cadre:Destroy()
		tuiles[i] = nil
	end
	if dossier then dossier.Parent = nil end
	ambiance(false)
	U.racine.Visible = false
	if U.fondu.Visible then
		TweenService:Create(U.fondu, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		task.delay(0.55, function() if not Garage.ouvert then U.fondu.Visible = false end end)
	end
end

-- le profil a changé (une partie finie, un achat validé ailleurs) : on rafraîchit ce qu'on montre
function Garage.majProfil()
	if Garage.ouvert then majTout() end
end

-- JOUER : équipe la caisse montrée si elle est ouverte (garageLaunch), puis le lâcher
function Garage.jouer()
	if not Garage.ouvert or Garage.lance or occupe then return end
	Garage.lance = true
	task.spawn(function()
		if ouverte(montre) and profil().caisse ~= montre then
			local ok = ctx.action("equiper", montre)
			if ok then ctx.surEquipe(montre) end
		elseif not ouverte(montre) and vitrine then
			-- on essayait une caisse fermée : on repart avec la sienne
			Garage.sauter(profil().caisse or 0, true)
		end
		Sons.jouer("decollage")
		TweenService:Create(U.racine, K.LENTE, { Position = UDim2.fromOffset(0, 40) }):Play()
		task.delay(0.25, function() if Garage.lance then U.racine.Visible = false end end)
		lacher = { t = 0, suite = function() ctx.surJouer() end }
	end)
end

return Garage
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000053"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — L'INTERFACE (menu, course, pause, réglages, mort), calquée sur la VERSION PRINCIPALE web.
-- Références : captures du jeu web à 1280×720 (menu CHUTE, course, écran de mort) — même disposition :
--   · MENU : le logo CASH CAR en haut à droite (or, barre tricolore rose/cyan/or dessous), ⚙ à droite,
--     JOUER en grandes lettres d'or en bas à droite ; la caisse qui pique à gauche, au-dessus des nuages.
--   · COURSE : ⚡ + la grande barre de NITRO en haut à gauche, AURA dessous ; en haut à droite la pause
--     cyan puis l'ARGENT vert et le chrono d'AIR ; le bouton NITRO en bas à droite ; la bannière du niveau.
--   · MORT : « NOUVEAU RECORD ! », le panneau vert VERSÉ AU COMPTE, AURA, MOTEUR ATTEINT, les stats,
--     HOME et le grand REJOUER doré.
-- Roblox n'a ni biais (skew) ni découpe (clip-path) : les plaques restent droites, le reste suit le web.
-- Police pixel (Press Start 2P, livrée avec Roblox), sans accents sur les capitales (elle ne les a pas).
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Controles = require(script.Parent:WaitForChild("Controles"))
local Sons = require(script.Parent:WaitForChild("Sons"))

local Hud = {}

-- ── la langue : français si le compte Roblox est en français, anglais sinon ──
local FR = string.sub(Players.LocalPlayer.LocaleId or "fr", 1, 2) == "fr"
Hud.FR = FR
local T = FR and {
	jouer = "JOUER", rejouer = "REJOUER", menu = "HOME", reprendre = "REPRENDRE", recommencer = "RECOMMENCER",
	pause = "PAUSE", son = "SON", musique = "MUSIQUE", record = "RECORD", nouveau = "NOUVEAU RECORD !",
	reglages = "REGLAGES", fermer = "FERMER", verse = "VERSE AU COMPTE", compte = "COMPTE :", meilleur = "MEILLEUR",
	moteurAtteint = "MOTEUR ATTEINT", palier = "PALIER", encore = "ENCORE %d PIECES POUR", moteurMax = "LE PLUS GROS MOTEUR",
	multiMax = "MULTI MAX", kmhMax = "KM/H MAX", zone = "ZONE", figures = "FIGURES", distance = "DISTANCE", pieces = "PIECES",
	aura = "AURA", moteur = "MOTEUR", nitro = "NITRO", air = "AIR", go = "GO !", niveau = "MER DE NUAGES",
	astuce = "ASTUCE", glisse = "GLISSE POUR\nTOURNER", chargement = "LA ROUTE SE CONSTRUIT",
		missions = "MISSIONS", garage = "GARAGE", carriere = "CARRIERE", boutique = "BOUTIQUE", bientot = "BIENTOT DISPONIBLE",
	astuces = {
		"Sors par le BORD de la route : tu voles, et tu te poses plus bas. C'est là que le jeu se joue.",
		"En l'air : flèche HAUT = plonge, flèche BAS = monte. Gauche / droite = les vrilles.",
		"Chaque pièce fait monter ton MOTEUR : plus de pièces, plus de vitesse.",
	},
	astucesTactile = {
		"Sors par le BORD de la route : tu voles, et tu te poses plus bas. C'est là que le jeu se joue.",
		"En l'air : pouce en HAUT = plonge, en BAS = monte. Gauche / droite = les vrilles.",
		"Chaque pièce fait monter ton MOTEUR : plus de pièces, plus de vitesse.",
	},
	morts = { air = "TROP LONGTEMPS EN L'AIR", vide = "AVALE PAR LE VIDE", arret = "EN PANNE SECHE", autre = "GAME OVER" },
} or {
	jouer = "PLAY", rejouer = "PLAY AGAIN", menu = "HOME", reprendre = "RESUME", recommencer = "RESTART",
	pause = "PAUSE", son = "SOUND", musique = "MUSIC", record = "BEST", nouveau = "NEW RECORD!",
	reglages = "SETTINGS", fermer = "CLOSE", verse = "PAID TO ACCOUNT", compte = "ACCOUNT:", meilleur = "BEST",
	moteurAtteint = "ENGINE REACHED", palier = "TIER", encore = "%d MORE COINS FOR", moteurMax = "THE BIGGEST ENGINE",
	multiMax = "MAX MULTI", kmhMax = "MAX KM/H", zone = "ZONE", figures = "TRICKS", distance = "DISTANCE", pieces = "COINS",
	aura = "AURA", moteur = "ENGINE", nitro = "NITRO", air = "AIR", go = "GO!", niveau = "SEA OF CLOUDS",
	astuce = "TIP", glisse = "SWIPE TO\nSTEER", chargement = "BUILDING THE ROAD",
		missions = "MISSIONS", garage = "GARAGE", carriere = "CAREER", boutique = "SHOP", bientot = "COMING SOON",
	astuces = {
		"Leave the road by the EDGE: you fly, and land lower down. That's where the game is.",
		"In the air: UP arrow = dive, DOWN arrow = climb. Left / right = spins.",
		"Every coin grows your ENGINE: more coins, more speed.",
	},
	astucesTactile = {
		"Leave the road by the EDGE: you fly, and land lower down. That's where the game is.",
		"In the air: thumb UP = dive, DOWN = climb. Left / right = spins.",
		"Every coin grows your ENGINE: more coins, more speed.",
	},
	morts = { air = "TOO LONG IN THE AIR", vide = "SWALLOWED BY THE VOID", arret = "OUT OF GAS", autre = "GAME OVER" },
}
Hud.T = T

-- ── la palette du web (charte v4/v5 : carbone, or, néon) ──
local PIX = Font.new("rbxasset://fonts/families/PressStart2P.json")
local TXT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
local C = {
	or_ = Color3.fromRGB(255, 215, 94), orFonce = Color3.fromRGB(255, 170, 20), orSh = Color3.fromRGB(150, 96, 12),
	cyan = Color3.fromRGB(0, 234, 255), rose = Color3.fromRGB(255, 110, 200), magenta = Color3.fromRGB(255, 62, 200),
	rouge = Color3.fromRGB(255, 94, 122), vert = Color3.fromRGB(98, 224, 98), menthe = Color3.fromRGB(150, 255, 190),
	orange = Color3.fromRGB(255, 128, 32), lavande = Color3.fromRGB(190, 180, 255),
	carbone = Color3.fromRGB(26, 22, 48), carbone2 = Color3.fromRGB(34, 28, 62), trait = Color3.fromRGB(64, 56, 110),
	nuit = Color3.fromRGB(16, 10, 36), piste = Color3.fromRGB(22, 18, 52),
	texte = Color3.fromRGB(236, 240, 255), texte2 = Color3.fromRGB(180, 200, 255), terne = Color3.fromRGB(143, 132, 200),
	encre = Color3.fromRGB(8, 6, 20),
	-- anciens noms (le pilote s'en sert)
	plaque = Color3.fromRGB(34, 48, 92), plaqueSh = Color3.fromRGB(6, 18, 46),
}
Hud.C = C
local RAPIDE = TweenInfo.new(0.09, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local LENTE = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function inst(classe: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(classe)
	for k, v in props do (o :: any)[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function texte(parent: Instance, props: { [string]: any }): TextLabel
	local t = inst("TextLabel", {
		BackgroundTransparency = 1, FontFace = PIX, TextColor3 = C.texte, TextSize = 16,
		Size = UDim2.new(1, 0, 0, 24), TextWrapped = true,
	}, parent)
	for k, v in props do
		if k ~= "epais" and k ~= "contour" and k ~= "contourCouleur" then (t :: any)[k] = v end
	end
	if props.contour ~= false then
		inst("UIStroke", { Color = props.contourCouleur or C.encre, Thickness = props.epais or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, t)
	end
	return t
end
local function degrade(parent: Instance, a: Color3, b: Color3, rot: number?)
	inst("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rot or 90 }, parent)
end
-- une plaque de CARBONE (le fond de tous les panneaux du web) avec son filet de couleur à gauche
local function carbone(parent: Instance, taille: UDim2, pos: UDim2, filet: Color3?, ancre: Vector2?): Frame
	local f = inst("Frame", { BackgroundColor3 = C.carbone, BorderSizePixel = 0, Size = taille, Position = pos,
		AnchorPoint = ancre or Vector2.zero }, parent)
	degrade(f, C.carbone2, C.carbone, 90)
	inst("UIStroke", { Color = C.trait, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
	if filet then
		inst("Frame", { BackgroundColor3 = filet, BorderSizePixel = 0, Size = UDim2.new(0, 6, 1, 0) }, f)
	end
	return f
end

local function retour(b: GuiButton, cible: GuiObject)
	local p0 = cible.Position
	b.MouseButton1Down:Connect(function()
		TweenService:Create(cible, RAPIDE, { Position = p0 + UDim2.fromOffset(0, 4) }):Play()
	end)
	local function relache() TweenService:Create(cible, RAPIDE, { Position = p0 }):Play() end
	b.MouseButton1Up:Connect(relache)
	b.MouseLeave:Connect(relache)
	b.Activated:Connect(function()
		Sons.jouer("tap")
		pcall(function()
			local HS = game:GetService("HapticService")
			if HS:IsVibrationSupported(Enum.UserInputType.Gamepad1) then
				HS:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, 0.4)
				task.delay(0.06, function() HS:SetMotor(Enum.UserInputType.Gamepad1, Enum.VibrationMotor.Small, 0) end)
			end
		end)
	end)
end

-- une TUILE du web : carbone + filet coloré + pictogramme + libellé
local function tuile(parent: Instance, libelle: string, filet: Color3, taille: UDim2, pos: UDim2, ancre: Vector2?, corps: number?): TextButton
	local f = carbone(parent, taille, pos, filet, ancre)
	local b = inst("TextButton", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), FontFace = PIX, Text = libelle,
		TextColor3 = C.texte, TextSize = corps or 16, AutoButtonColor = false }, f)
	inst("UIStroke", { Color = C.encre, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, b)
	retour(b, f)
	return b
end

-- le GRAND bouton doré (REJOUER, REPRENDRE) : dégradé or, texte encre
local function lingot(parent: Instance, libelle: string, taille: UDim2, pos: UDim2, ancre: Vector2?, corps: number?): TextButton
	local f = inst("Frame", { BackgroundColor3 = C.or_, BorderSizePixel = 0, Size = taille, Position = pos, AnchorPoint = ancre or Vector2.zero }, parent)
	degrade(f, Color3.fromRGB(255, 244, 150), Color3.fromRGB(255, 168, 0), 90)
	inst("UIStroke", { Color = C.orSh, Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
	local b = inst("TextButton", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), FontFace = PIX, Text = libelle,
		TextColor3 = Color3.fromRGB(40, 22, 4), TextSize = corps or 34, AutoButtonColor = false }, f)
	retour(b, f)
	return b
end

-- le KIT d'interface, prêté aux autres écrans (garage, missions, carrière…) : une seule charte
Hud.kit = { inst = inst, texte = texte, degrade = degrade, carbone = carbone, tuile = tuile, lingot = lingot, retour = retour,
	PIX = PIX, TXT = TXT, RAPIDE = RAPIDE, LENTE = LENTE }

-- ── les formats d'argent (fmtC, L12383) ──
local UNITES = FR and { { 1e15, "Bd" }, { 1e12, "Bn" }, { 1e9, "Md" }, { 1e6, "M" }, { 1e3, "k" } }
	or { { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "k" } }
function Hud.nombre(v: number): string
	local s
	if v < 1000 then
		s = string.format("%.2f", v)
	else
		s = string.format("%.0f", v)
		for _, u in UNITES do
			if v >= u[1] * 0.9995 then
				local q = v / u[1]
				s = (q < 100 and string.format("%.1f", q) or string.format("%.0f", q)) .. " " .. u[2]
				break
			end
		end
	end
	if FR then s = string.gsub(s, "%.", ",") end
	return s
end
function Hud.argent(v: number): string
	return "$ " .. Hud.nombre(v)
end
function Hud.compte(v: number): string
	local s = tostring(math.floor(v + 0.5))
	local out = string.reverse(string.gsub(string.reverse(s), "(%d%d%d)", FR and "%1 " or "%1,"))
	out = string.gsub(out, "^[ ,]", "")
	return (FR and "$ " or "$") .. out
end
function Hud.entier(v: number): string
	local s = tostring(math.floor(v + 0.5))
	local out = string.reverse(string.gsub(string.reverse(s), "(%d%d%d)", "%1 "))
	return (string.gsub(out, "^ ", ""))
end

-- ════════════════════════════════════════════════════════════════════════════════════════════════
local gui: ScreenGui
local E = {} -- les éléments qu'on met à jour
Hud.E = E

function Hud.creer()
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	gui = inst("ScreenGui", {
		Name = "CashCar", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets, DisplayOrder = 5,
	}, pg)
	local tactile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	-- tout est dessiné pour un écran de 720 px de haut : une RACINE de 1/k de l'écran, agrandie k fois
	local racine = inst("Frame", { Name = "Racine", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	Hud.racine = racine -- les autres écrans (garage…) se posent dans la même racine mise à l'échelle
	local echelle = inst("UIScale", {}, racine)
	local function recaler()
		local cam = workspace.CurrentCamera
		local h = cam and cam.ViewportSize.Y or 720
		local k = math.clamp(h / 720, tactile and 0.8 or 0.5, 1.5)
		echelle.Scale = k
		racine.Size = UDim2.fromScale(1 / k, 1 / k)
	end
	recaler()
	if workspace.CurrentCamera then workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(recaler) end
	local gStick = inst("ScreenGui", { Name = "CashCarStick", ResetOnSpawn = false, IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None, DisplayOrder = 6 }, pg)

	-- ══ CHARGEMENT ══
	E.charge = inst("Frame", { BackgroundColor3 = C.nuit, Size = UDim2.fromScale(1, 1), ZIndex = 50 }, racine)
	local lg = texte(E.charge, { Text = "CASH CAR", TextSize = 64, TextColor3 = C.or_, Size = UDim2.new(1, 0, 0, 80),
		Position = UDim2.fromScale(0, 0.34), ZIndex = 51, epais = 4 })
	degrade(lg, Color3.fromRGB(255, 244, 170), C.orFonce, 90)
	E.chargeTxt = texte(E.charge, { Text = T.chargement, TextSize = 14, TextColor3 = C.texte2, Position = UDim2.fromScale(0, 0.52), ZIndex = 51 })

	-- ══ MENU (la CHUTE) ══
	local menu = inst("Frame", { Name = "Menu", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, racine)
	E.menu = menu
	-- le logo, en haut à droite, et sa barre tricolore
	local logo = inst("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(620, 150), Position = UDim2.new(1, -40, 0, 20),
		AnchorPoint = Vector2.new(1, 0) }, menu)
	local ombre = texte(logo, { Text = "CASH CAR", TextSize = 80, TextColor3 = Color3.fromRGB(90, 40, 10), Size = UDim2.new(1, 0, 0, 90),
		Position = UDim2.fromOffset(6, 8), TextXAlignment = Enum.TextXAlignment.Right, contour = false })
	ombre.TextTransparency = 0.1
	local titre = texte(logo, { Text = "CASH CAR", TextSize = 80, TextColor3 = C.or_, Size = UDim2.new(1, 0, 0, 90),
		TextXAlignment = Enum.TextXAlignment.Right, epais = 4, contourCouleur = Color3.fromRGB(60, 24, 6) })
	-- (le LOGO est la seule dérogation de la charte au texte en dégradé : c'est une image de marque)
	inst("UIGradient", { Rotation = 90, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 246, 180)), ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 196, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 120, 90)) }) }, titre)
	E.titre = titre
	local barre = inst("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 540, 0, 8), Position = UDim2.new(1, -20, 0, 108),
		AnchorPoint = Vector2.new(1, 0) }, logo)
	for i, c in { C.magenta, C.cyan, C.or_ } do
		inst("Frame", { BackgroundColor3 = c, BorderSizePixel = 0, Size = UDim2.new(i == 1 and 0.4 or 0.28, -8, 1, 0),
			Position = UDim2.fromScale(i == 1 and 0 or (i == 2 and 0.4 or 0.68), 0) }, barre)
	end
	E.menuRecord = texte(logo, { Text = "", TextSize = 14, TextColor3 = C.vert, Position = UDim2.fromOffset(0, 126),
		TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(1, -20, 0, 20) })
	-- la colonne de droite du web (#mHome) : MISSIONS + ⚙, puis GARAGE · CARRIERE · BOUTIQUE, puis JOUER en lettres d'or
	E.btMissions = tuile(menu, "◎ " .. T.missions, C.vert, UDim2.fromOffset(282, 52), UDim2.new(1, -388, 1, -220), nil, 14)
	E.btReglages = tuile(menu, "⚙", C.cyan, UDim2.fromOffset(58, 52), UDim2.new(1, -98, 1, -220), nil, 24)
	E.btGarage = tuile(menu, T.garage, C.cyan, UDim2.fromOffset(112, 60), UDim2.new(1, -388, 1, -160), nil, 11)
	E.btCarriere = tuile(menu, T.carriere, C.cyan, UDim2.fromOffset(112, 60), UDim2.new(1, -270, 1, -160), nil, 11)
	E.btBoutique = tuile(menu, T.boutique, C.magenta, UDim2.fromOffset(112, 60), UDim2.new(1, -152, 1, -160), nil, 11)
	local jouer = inst("TextButton", { BackgroundTransparency = 1, AutoButtonColor = false, Size = UDim2.fromOffset(348, 70),
		Position = UDim2.new(1, -214, 1, -18), AnchorPoint = Vector2.new(0.5, 1), FontFace = PIX, Text = T.jouer, TextSize = 56,
		TextColor3 = C.or_ }, menu)
	inst("UIStroke", { Color = Color3.fromRGB(60, 24, 6), Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual }, jouer)
	inst("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 244, 170), C.orFonce) }, jouer)
	retour(jouer, jouer)
	E.btJouer = jouer

	-- ══ COURSE ══
	local hud = inst("Frame", { Name = "Course", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, racine)
	E.hud = hud
	-- ⚡ + la barre de nitro
	texte(hud, { Text = "⚡", TextSize = 38, FontFace = TXT, Size = UDim2.fromOffset(44, 48), Position = UDim2.fromOffset(20, 18), contour = false })
	local fondN = inst("Frame", { BackgroundColor3 = C.piste, BorderSizePixel = 0, Size = UDim2.new(0.46, 0, 0, 38),
