--   · l'ENTONNOIR DES NOUVEAUX (Onboarding) : arrivé → première course → première fin → deuxième course → une minute tenue →
--     première caisse achetée. On y lit OÙ un nouveau joueur décroche : c'est la courbe qui fait (ou défait) un jeu Roblox.
--   · l'ÉCONOMIE (Economy) : chaque dollar du jeu qui entre (course, cadeaux, roue, packs payés) et qui sort (caisses, habillages),
--     avec le solde — on voit si l'argent coule trop vite ou trop lentement.
--   · quelques ÉVÉNEMENTS (Custom) : la zone atteinte, le montant d'une course, un cœur utilisé, un achat en Robux.
-- Tout passe par pcall : une statistique ne casse jamais le jeu (et en Studio, Roblox n'enregistre rien).
local AS = game:GetService("AnalyticsService")
local Players = game:GetService("Players")
local ET = Enum.AnalyticsEconomyTransactionType

local A = {}
A.T = {
	jeu = ET.Gameplay.Name, achatRobux = ET.IAP.Name, boutique = ET.Shop.Name,
	cadeau = ET.TimedReward.Name, accueil = ET.Onboarding.Name,
}

-- l'entonnoir : seulement pour un NOUVEAU joueur (aucune partie au compteur), chaque étape une fois et dans l'ordre
local suivi: { [number]: { etape: number, debuts: number } } = {}
local function etape(p: Player, n: number, nom: string)
	local s = suivi[p.UserId]
	if not s or n ~= s.etape + 1 then return end
	s.etape = n
	pcall(function() AS:LogOnboardingFunnelStepEvent(p, n, nom) end)
end

function A.arrivee(p: Player, prof: any)
	local neuf = type(prof.stats) == "table" and prof.stats.parties == 0
	suivi[p.UserId] = neuf and { etape = 0, debuts = 0 } or nil
	if neuf then etape(p, 1, "Arrive") end
end
function A.depart(p: Player)
	suivi[p.UserId] = nil
end

-- une course part (la montre du serveur démarre)
function A.debut(p: Player)
	local s = suivi[p.UserId]
	if not s then return end
	s.debuts += 1
	if s.debuts == 1 then etape(p, 2, "Premiere course") end
	if s.debuts == 2 then etape(p, 4, "Deuxieme course") end
end

-- une course finit : l'entonnoir, la zone, le montant
function A.fin(p: Player, montant: number, stats: any, duree: number)
	etape(p, 3, "Premiere fin")
	if duree >= 60 then etape(p, 5, "Une minute tenue") end
	pcall(function()
		if type(stats) == "table" and type(stats.zone) == "number" then AS:LogCustomEvent(p, "ZoneAtteinte", stats.zone) end
		AS:LogCustomEvent(p, "MontantCourse", math.floor(montant))
		AS:LogCustomEvent(p, "DureeCourse", math.floor(duree))
	end)
end

-- l'argent du jeu qui bouge : `montant` > 0 entre, < 0 sort ; `solde` = le compte APRÈS ; `quoi` = un des A.T ; `article` = ce que c'est
function A.argent(p: Player, montant: number, solde: number, quoi: string, article: string?)
	if montant == 0 or montant ~= montant then return end
	local sens = montant > 0 and Enum.AnalyticsEconomyFlowType.Source or Enum.AnalyticsEconomyFlowType.Sink
	pcall(function() AS:LogEconomyEvent(p, sens, "Dollars", math.floor(math.abs(montant)), math.floor(solde), quoi, article) end)
	if montant < 0 and article and string.sub(article, 1, 7) == "caisse:" then etape(p, 6, "Premiere caisse achetee") end
end

-- un événement nommé (un cœur utilisé, un achat en Robux…)
function A.evenement(p: Player, nom: string, valeur: number?)
	pcall(function() AS:LogCustomEvent(p, nom, valeur or 1) end)
end

Players.PlayerRemoving:Connect(A.depart)

return A
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CE"><Properties><string name="Name">Profils</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LES PROFILS (serveur). Tout ce qu'un joueur garde d'une partie à l'autre : le COMPTE (l'argent
-- versé à chaque fin de partie), le record, les caisses achetées et celle qu'il conduit, les peintures,
-- les missions, la carrière, les réglages. UNE entrée DataStore par joueur, versionnée (comme SAVE.d du web).
--
-- Le client DEMANDE (acheter, équiper, régler, réclamer une mission…), le serveur VÉRIFIE (prix, argent,
-- possession) puis renvoie le profil à jour : un joueur ne peut pas s'offrir une caisse en trichant.
-- Les règles de chaque action vivent dans Profils.actions (les systèmes s'y branchent : garage, missions…).
local DataStoreService = game:GetService("DataStoreService")

local Profils = {}
local Carnets = require(game:GetService("ReplicatedStorage"):WaitForChild("CashCar"):WaitForChild("Carnets"))

local VERSION = 1
local store
do
	local ok, s = pcall(function() return DataStoreService:GetDataStore("CashCarProfils_v1") end)
	if ok then store = s end
end

export type Profil = { [string]: any }

-- la forme garantie d'un profil (san() du web : tout ce qui entre est désinfecté)
function Profils.neuf(): Profil
	return {
		v = VERSION,
		compte = 0, record = 0, auraMeilleur = 0,
		recordPur = 0, -- (5/10) le meilleur record SANS AIDE (ni cœur, ni nitro infinie, ni mode facile) : lui seul entre au TOP 10
		kmhMax = 0, -- la plus grande vitesse jamais atteinte (km/h affichés)
		moteurMax = 0, -- le meilleur palier de MOTEUR jamais atteint (SAVE.d.ex.eng du web) : l'écran de fin dit « RECORD ! » s'il est battu
		aura = 0,      -- l'aura de TOUJOURS (elle fait le rang : ANONYME … DIVINITÉ DU CIEL)
		frenRec = 0,   -- la plus longue frénésie (s)
		caisses = { 0 }, caisse = 0, -- indices du jeu web : 0 = LA HONTE, la caisse de départ
		peintures = {}, peinture = 0,
		traines = {}, trainee = 0,
		mis = { n = 0, ok = { false, false, false }, best = { 0, 0, 0 }, f = -1 }, -- les CARNETS (voir Carnets)
		habits = {},   -- les habillages gagnés ou achetés : « peinture:or », « trainee:arcenciel »…
		porte = { peinture = "usine", aile = "panneaux", trainee = "nitro" }, -- ce que la caisse porte
		carriere = {},
		reglages = { son = true, musique = true, facile = false, facileChoisi = false, tuto = false,
			volSon = 100, volMus = 62, volH = "plonge", vib = true, -- (les curseurs de volume du web : 100 % et 62 % ; POUCE HAUT EN VOL ; VIBRATIONS)
			ast1 = false, ast2 = false, ast3 = false, ast4 = false, shopVu = false, -- (shopVu : la BOUTIQUE a été visitée — sa pastille NEW s'éteint) -- les ASTUCES déjà lues (une fois à vie) : le bord, le vol, les pièces, le drift
			nitroInf = true }, -- (5/10) le passe NITRO INFINIE allumé (son interrupteur, colonne JEU des réglages : rejouer avec la jauge quand on veut)
		permis = false, -- le PERMIS de l'auto-école : +500 $, une seule fois dans la vie du compte
		stats = { parties = 0, distance = 0, pieces = 0, figures = 0 },
		-- les REVENUS (voir Revenus) : le cadeau du jour (son jour UTC, la série), le bonus de groupe pris, qui m'a invité, les reçus
		-- d'achat déjà servis (un reçu ne sert jamais deux fois)
		jour = 0, serie = 0, groupe = false, invite = 0, achats = {},
		-- LES CŒURS (le produit à 50 R$, Sacha 5/10) : le stock de vies en plus — un cœur se dépense quand la caisse devait exploser
		-- (action « coeur »), un achat en ajoute un (ProcessReceipt, voir Revenus)
		coeurs = 0,
		-- LE KIT DU PILOTE (5/10, l'offre de bienvenue en Robux) : déjà acheté — une fois par compte, il quitte la boutique
		kit = false,
		-- LA ROUE : les tours en réserve, l'heure (os.time) du dernier tour gratuit, les parties vers le prochain tour offert, la caisse
		-- qui vient d'être gagnée et qu'on peut encore préférer en argent (-1 : aucune)
		roue = { n = 0, libre = 0, parties = 0, attente = -1 },
	}
end

local Catalogue = require(game:GetService("ReplicatedStorage"):WaitForChild("CashCar"):WaitForChild("Caisses"):WaitForChild("Catalogue"))
local function sain(p: any): Profil
	local n = Profils.neuf()
	if type(p) ~= "table" then return n end
	for k, v in n do
		if k == "reglages" or k == "porte" or k == "roue" then
			-- (clé par clé : un vieux profil n'a pas les réglages ajoutés depuis)
			if type(p[k]) == "table" then
				for rk, rv in v do
					if type(p[k][rk]) == type(rv) then v[rk] = p[k][rk] end
				end
			end
		elseif type(p[k]) == type(v) then
			n[k] = p[k]
		end
	end
	local achats = {}
	for _, a in n.achats do
		if type(a) == "string" and #a < 80 and #achats < 30 then table.insert(achats, a) end
	end
	n.achats = achats
	for _, k in { "n", "libre", "parties" } do
		local v = n.roue[k]
		if v ~= v or v < 0 or v > 1e12 then n.roue[k] = 0 end
	end
	for _, k in { "compte", "record", "recordPur", "auraMeilleur", "aura", "frenRec", "moteurMax", "kmhMax", "jour", "serie", "invite", "coeurs" } do
		if n[k] ~= n[k] or n[k] < 0 or n[k] > 1e18 then n[k] = 0 end
	end
	n.coeurs = math.floor(n.coeurs) -- (des cœurs ENTIERS : un demi-cœur ne sauve personne)
	local possede = {}
	local liste = {}
	for _, i in n.caisses do
		if type(i) == "number" and i == math.floor(i) and i >= 0 and i < 1000 and not possede[i] then
			local f = Catalogue[i]
			if f and f.retire then
				-- LES CAISSES RETIRÉES (san, 2/10) : qui en avait acheté une est REMBOURSÉ au prix payé — une mise à jour ne confisque
				-- pas — et elle sort de la liste (le remboursement ne joue donc qu'une fois)
				if f.cond.k == "prix" then n.compte += f.cond.v end
			else
				possede[i] = true
				table.insert(liste, i)
			end
		end
	end
	if not possede[0] then table.insert(liste, 0) end
	n.caisses = liste
	if type(n.caisse) ~= "number" or n.caisse ~= math.floor(n.caisse) or n.caisse < 0 then n.caisse = 0 end
	if Catalogue[n.caisse] and Catalogue[n.caisse].retire then n.caisse = 0 end -- (qui roulait avec une caisse retirée repart en LA HONTE)
	-- (4/10, version publique) une caisse équipée qu'on ne possède pas — un reste des essais où tout s'équipait : retour à LA HONTE
	local CfgP = require(game:GetService("ReplicatedStorage"):WaitForChild("CashCar"):WaitForChild("Config"))
	if not possede[n.caisse] and not CfgP.TEST_CAISSES then n.caisse = 0 end
	n.mis = Carnets.etat(n.mis)
	local habits = {}
	for _, h in n.habits do
		if type(h) == "string" and #h < 60 and not table.find(habits, h) then table.insert(habits, h) end
	end
	n.habits = habits
	return n
end

local actifs: { [number]: Profil } = {}

-- ⚠ UNE LECTURE RATÉE N'EST PAS UN JOUEUR NEUF. Avant le 3/10, une panne de la sauvegarde à l'arrivée donnait un profil VIDE — et la
-- première écriture effaçait pour de bon les caisses, l'argent et les réglages du joueur. On essaie trois fois (1 s, 2 s, 4 s) ; si
-- la sauvegarde ne répond toujours pas, la session joue sur un profil neuf SANS JAMAIS l'écrire (`horsLigne`), et le joueur le sait.
-- (5/10) UNE SEULE LECTURE À LA FOIS par joueur : le profil était parfois lu DEUX fois à l'arrivée (l'arrivée + une demande du
-- client, ou un reçu d'achat en attente), et la seconde lecture, plus lente, remplaçait la première — avec ce qu'on y avait déjà
-- crédité. La seconde demande attend la première et rend le MÊME profil.
local enLecture: { [number]: boolean } = {}
function Profils.pret(p: Player): boolean
	return actifs[p.UserId] ~= nil and not enLecture[p.UserId]
end
function Profils.charger(p: Player): Profil
	local id = p.UserId
	if enLecture[id] then
		while enLecture[id] and p.Parent do task.wait(0.1) end
		local deja = actifs[id]
		if deja then return deja end
		local hors = Profils.neuf() -- (parti pendant la lecture : un profil jetable, jamais écrit)
		;(hors :: any).horsLigne = true
		return hors
	end
	if actifs[id] then return actifs[id] end
	enLecture[id] = true
	local prof = Profils.neuf()
	if store then
		local lu, v = false, nil
		for essai = 1, 4 do
			local ok, r = pcall(function() return store:GetAsync("p_" .. p.UserId) end)
			if ok then
				lu, v = true, r
				break
			end
			-- (dans Studio sans accès aux services en ligne, la lecture échoue TOUJOURS : pas d'essai de plus, pas d'alerte — rien n'y est
			-- gardé de toute façon)
			if game:GetService("RunService"):IsStudio() then break end
			warn("[CashCar] sauvegarde illisible pour " .. p.Name .. " (essai " .. essai .. ") : " .. tostring(r))
			if essai < 4 then task.wait(2 ^ (essai - 1)) end
		end
		if lu and v ~= nil then
			local okS, r = pcall(sain, v)
			if okS then
				prof = r
			else
				lu = false -- (une sauvegarde qu'on ne sait pas relire : on ne l'écrasera pas non plus)
			end
		end
		if not lu then
			(prof :: any).horsLigne = true
			if not game:GetService("RunService"):IsStudio() then p:SetAttribute("SauvegardeKO", true) end
		end
	end
	-- (parti pendant la lecture : on ne garde rien — sinon ce profil-là resservirait, périmé, à son retour sur ce serveur)
	if p.Parent then actifs[id] = prof end
	enLecture[id] = nil
	return prof
end

function Profils.de(p: Player): Profil
	return actifs[p.UserId] or Profils.charger(p)
end

-- rend VRAI si le profil est écrit (5/10 : un achat en Robux n'est accordé qu'à cette condition — voir Revenus)
function Profils.sauver(p: Player): boolean
	local prof = actifs[p.UserId]
	if not prof or not store or (prof :: any).horsLigne then return false end -- (lecture ratée : on n'écrase rien)
	local efface = prof.efface
	prof.efface = nil
	local ok = pcall(function()
		store:UpdateAsync("p_" .. p.UserId, function(ancien)
			if efface then return prof end -- (une progression EFFACÉE ne reprend rien de l'ancienne)
			-- jamais en arrière : l'argent et le record ne redescendent pas si deux serveurs se croisent
			local a = sain(ancien)
			prof.record = math.max(prof.record, a.record)
			prof.recordPur = math.max(prof.recordPur, a.recordPur)
			prof.auraMeilleur = math.max(prof.auraMeilleur, a.auraMeilleur)
			prof.moteurMax = math.max(prof.moteurMax, a.moteurMax)
			prof.kmhMax = math.max(prof.kmhMax, a.kmhMax)
			return prof
		end)
	end)
	if not ok and efface then prof.efface = true end -- (l'écriture a raté : l'effacement repartira avec la suivante)
	return ok
end

-- LES ÉCRITURES SE REGROUPENT : Roblox n'accepte qu'une écriture toutes les 6 s sur une même clé — au-delà il les met en file,
-- puis les JETTE quand la file est pleine. Un réglage, une astuce vue, le permis, une fin de partie : chacun demandait la sienne.
-- Ici, une seule écriture au plus toutes les 7 s par joueur ; ce qui arrive entre-temps part avec la suivante (le profil est le même
-- objet, toujours à jour). Quand le joueur s'en va, `Profils.sauver` écrit tout de suite.
local enAttente: { [number]: boolean } = {}
local derniere: { [number]: number } = {}
function Profils.sauverBientot(p: Player)
	local id = p.UserId
	if enAttente[id] then return end
	enAttente[id] = true
	task.spawn(function()
		local attente = 7 - (os.clock() - (derniere[id] or -100))
		if attente > 0 then task.wait(attente) end
		enAttente[id] = nil
		derniere[id] = os.clock()
		Profils.sauver(p) -- (parti entre-temps : son profil est déjà écrit et oublié, sauver ne fait rien)
	end)
end
-- ÉCRIRE MAINTENANT, et savoir si c'est fait (5/10 : les ACHATS EN ROBUX — ProcessReceipt ne répond « accordé » qu'une fois l'achat
-- écrit ; s'il ne l'est pas, Roblox représentera le reçu). Hors du regroupement de 7 s : Roblox met en file une écriture trop
-- rapprochée sur la même clé (l'appel attend son tour), il ne la refuse pas.
function Profils.sauverMaintenant(p: Player): boolean
	derniere[p.UserId] = os.clock()
	return Profils.sauver(p)
end
function Profils.oublier(p: Player)
	actifs[p.UserId] = nil
end

-- les actions que le client peut demander : nom → function(joueur, profil, ...) → ok, message
Profils.actions = {} :: { [string]: (Player, Profil, ...any) -> (boolean, string?) }

-- ── le GARAGE : acheter et équiper (le catalogue est celui du jeu web, cuit) ──
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("CashCar"):WaitForChild("Config"))
local Analytique = require(script.Parent:WaitForChild("Analytique")) -- (l'argent qui sort : caisses, habillages)
function Profils.possede(prof: Profil, i: number): boolean
	return table.find(prof.caisses, i) ~= nil
end
Profils.actions.acheter = function(p, prof, i)
	local f = type(i) == "number" and Catalogue[i]
	if not f or f.retire then return false, "caisse inconnue" end
	if Profils.possede(prof, i) then return false, "deja a toi" end
	if f.cond.k ~= "prix" then return false, "pas a vendre" end
	if prof.compte < f.cond.v then return false, "pas assez" end
	prof.compte -= f.cond.v
	table.insert(prof.caisses, i)
	Analytique.argent(p, -f.cond.v, prof.compte, Analytique.T.boutique, "caisse:" .. i)
	return true -- (comme carBuy du web : la caisse achetée n'est PAS équipée d'office)
end
Profils.actions.equiper = function(p, prof, i)
	local f = type(i) == "number" and Catalogue[i]
	if not f or f.retire then return false, "caisse inconnue" end
	if not Profils.possede(prof, i) and not Config.TEST_CAISSES then return false, "pas a toi" end
	prof.caisse = i
	if Profils.surEquipe then Profils.surEquipe(p, i) end
	return true
end

-- ── les MISSIONS (retirées du jeu le 4/10 : la ROUE les remplace) — leurs actions ne répondent plus : « defi » payait sur la simple
-- parole du joueur. Le carnet reste dans le profil (les vieilles sauvegardes), plus rien ne le fait avancer. ──
-- ── les HABILLAGES (shopBuy / shopEquip, L22150) : peintures, ailes, traînées ──
local function habit(cat: any, id: any): any
	local l = type(cat) == "string" and Config.HABITS[cat]
	if not l then return nil end
	for _, d in l do
		if d.id == id then return d end
	end
	return nil
end
function Profils.aHabit(prof: Profil, cat: string, id: string): boolean
	local d = habit(cat, id)
	if not d then return false end
	if not d.p and not d.mis and not d.roue then return true end -- offert
	return table.find(prof.habits, cat .. ":" .. id) ~= nil
end
Profils.actions.habitAcheter = function(p, prof, cat, id)
	local d = habit(cat, id)
	if not d or not d.p then return false, "pas a vendre" end
	if Profils.aHabit(prof, cat, id) then return false, "deja a toi" end
	if prof.compte < d.p then return false, "pas assez" end
	prof.compte -= d.p
	table.insert(prof.habits, cat .. ":" .. id)
	Analytique.argent(p, -d.p, prof.compte, Analytique.T.boutique, "habit:" .. cat .. ":" .. id)
	prof.porte[cat] = id -- (un habillage acheté est porté tout de suite — pas une caisse)
	if Profils.surHabit then Profils.surHabit(p) end
	return true
end
Profils.actions.habitEquiper = function(p, prof, cat, id)
	if not habit(cat, id) or not Profils.aHabit(prof, cat, id) then return false, "pas a toi" end
	prof.porte[cat] = id
	if Profils.surHabit then Profils.surHabit(p) end
	return true
end

Profils.actions.permis = function(p, prof)
	if prof.permis then return false, "deja" end
	prof.permis = true
	prof.compte += 500
	Analytique.argent(p, 500, prof.compte, Analytique.T.accueil, "permis")
	return true
end
-- EFFACER MA PROGRESSION (L39243 du jeu web, avec confirmation côté joueur) : le profil repart à zéro. `efface` dit à la sauvegarde de
-- ne PAS fusionner avec l'ancien (sinon le record, l'aura et le moteur effacés y reviendraient — « jamais en arrière »).
-- (5/10) ce qui a été PAYÉ EN ROBUX ne s'efface pas : les cœurs en réserve, et les reçus déjà servis (sans eux, un reçu que Roblox
-- représente serait servi une seconde fois). Les passes, eux, vivent chez Roblox : rien à garder ici.
-- (5/10, lot 2) ni les CAISSES LÉGENDAIRES achetées, ni le KIT DU PILOTE (et l'habillage qu'il offre) : payés, gardés.
Profils.actions.effacer = function(_, prof)
	local n = Profils.neuf()
	local coeurs, achats, kit = prof.coeurs, prof.achats, prof.kit == true
	local payees = {}
	for _, i in (type(prof.caisses) == "table" and prof.caisses or {}) do
		local f = type(i) == "number" and Catalogue[i]
		if f and f.cond.k == "premium" then table.insert(payees, i) end
	end
	for k in pairs(prof) do prof[k] = nil end
	for k, v in n do prof[k] = v end
	if type(coeurs) == "number" then prof.coeurs = coeurs end
	if type(achats) == "table" then prof.achats = achats end
	for _, i in payees do table.insert(prof.caisses, i) end
	if kit then
		prof.kit = true
		table.insert(prof.habits, Config.REVENUS.kit.habit)
	end
	prof.efface = true
	return true
end
Profils.actions.reglage = function(p, prof, cle, valeur)
	if type(cle) ~= "string" or prof.reglages[cle] == nil or type(valeur) ~= type(prof.reglages[cle]) then
		return false, "reglage inconnu"
	end
	if type(valeur) == "number" then
		if valeur ~= valeur then return false, "reglage inconnu" end
		valeur = math.clamp(math.floor(valeur / 5 + 0.5) * 5, 0, 100) -- (les curseurs vont de 0 à 100 %, par pas de 5)
	elseif type(valeur) == "string" and valeur ~= "plonge" and valeur ~= "monte" then
		return false, "reglage inconnu"
	end
	prof.reglages[cle] = valeur
	if Profils.surReglage then Profils.surReglage(p, prof, cle) end -- (5/10 : NITRO INFINIE coupée ou rallumée — voir Revenus)
	return true
end

return Profils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CF"><Properties><string name="Name">Revenus</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LES REVENUS (serveur). Ce qui fait vivre — et rapporter — un jeu Roblox, HORS de la boutique des caisses :
--   · LES RAISONS DE REVENIR (Roblox paie les créateurs au TEMPS que ses membres Premium passent dans le jeu) : le CADEAU DU JOUR et
--     sa SÉRIE (7 jours qui montent), les CADEAUX DE TEMPS DE JEU (5, 15, 30, 60 min dans la session), les BADGES, le CLASSEMENT
--     MONDIAL ; le BONUS PREMIUM (+10 % d'argent : on donne aux membres Premium une raison de jouer ici) ;
--   · LE BOUCHE-À-OREILLE : le bonus de GROUPE (une fois), les INVITATIONS d'amis (les deux sont récompensés) ;
--   · LES ACHATS EN ROBUX (Sacha, 5/10 : « fais de ce jeu une usine à fric ») — en tête de la BOUTIQUE, et là où ils ont un sens :
--     le passe « ×2 ARGENT » (500 R$ ; aussi proposé à l'écran de fin, au moment où l'on voit ce qu'on aurait gagné), le passe
--     « NITRO INFINIE » (700 R$ : la réserve ne se vide jamais — attribut joueur NitroInfini, lu par le pilote), le passe VIP
--     (cadeaux doublés, nom doré), et le produit CŒUR (50 R$, achat répété : une vie de plus, GARDÉE dans le profil — proposé aussi
--     à la mort quand on n'en a plus : acheté, il est dépensé aussitôt et la caisse repart là où elle a explosé) ;
--   · LA ROUE : un tour gratuit toutes les 4 h, un tour offert toutes les 3 parties, des tours à vendre — le tirage se fait ICI
--     (jamais chez le joueur) : de l'argent, une caisse EXCLUSIVE (à garder ou à revendre, au choix), un habillage, le jackpot.
--   · (5/10, lot 2 de l'usine à fric) les PACKS DE CŒURS (5, 15), les PACKS D'ARGENT (5 paliers), le KIT DU PILOTE (l'offre de
--     bienvenue, une fois par compte) et les 13 CAISSES LÉGENDAIRES (achat unique, purement cosmétique) — tous des PRODUITS, tous
--     accordés par la même porte (`recevoir`) : ProcessReceipt, et le banc DbgAchat ;
--   · (5/10) UN ACHAT N'EST ACCORDÉ QU'UNE FOIS ÉCRIT : le profil est sauvé AVANT de répondre « accordé » à Roblox ; s'il ne l'est pas,
--     Roblox représentera le reçu — et un reçu déjà servi ne crédite jamais deux fois (`prof.achats`).
--   · (5/10) le passe NITRO INFINIE s'éteint et se rallume (réglage « nitroInf ») : `NitroPasse` = on l'a, `NitroInfini` = il agit.
-- ⚠ Les numéros (passes, produits, badges, groupe) se posent dans Config.REVENUS une fois créés sur create.roblox.com par Sacha : à 0,
-- l'objet n'existe pas encore et tout ce qui en dépend se tait (rien ne se vend sans lui). Le cadeau du jour, le temps de jeu, le
-- classement et les invitations marchent sans rien créer.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local BadgeService = game:GetService("BadgeService")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")

local CC = ReplicatedStorage:WaitForChild("CashCar")
local Config = require(CC:WaitForChild("Config"))
local Catalogue = require(CC:WaitForChild("Caisses"):WaitForChild("Catalogue"))
local An = require(script.Parent:WaitForChild("Analytique")) -- (les statistiques Roblox : l'argent qui entre, les achats)
local R = Config.REVENUS
local RO = Config.ROUE

local Revenus = {}
local ctx: any = nil
-- (payes : les passes achetés PENDANT la session — Roblox garde en cache la réponse de UserOwnsGamePassAsync, qui peut encore dire
-- « non » juste après l'achat : un passe payé ici ne se reperd pas)
local droits: { [number]: { argent2: boolean, nitroInfini: boolean, vip: boolean, premium: boolean, payes: { [string]: boolean } } } = {}
-- (aide : la partie en cours a été AIDÉE — un cœur, la nitro infinie, le mode facile — elle ne compte pas au TOP 10 ;
-- inscrit : le record déjà écrit au classement pendant cette session)
local session: { [number]: { debut: number, n: number, badges: { [string]: boolean }, inscrit: number, aide: boolean } } = {}
local Studio = game:GetService("RunService"):IsStudio()

local function jourDe(t: number): number return math.floor(t / 86400) end -- (le jour UTC : le même pour tous les serveurs)

-- ── les DROITS : passes possédés, Premium ──
-- (banc) workspace:SetAttribute("DbgPasse", "nitroInfini") — ou "argent2", "vip", ou plusieurs : « nitroInfini,argent2 » — fait comme
-- si le joueur possédait ce passe (Studio seulement : en ligne, seul Roblox dit ce qu'on possède)
local function passeSimule(nom: string): boolean
	if not Studio then return false end
	local q = workspace:GetAttribute("DbgPasse")
	return type(q) == "string" and string.find("," .. q .. ",", "," .. nom .. ",", 1, true) ~= nil
end
-- LA NITRO INFINIE (5/10) : `NitroPasse` = le passe est à lui (la boutique dit ACTIF, les réglages montrent l'interrupteur) ;
-- `NitroInfini` = elle AGIT (le pilote le lit : la réserve ne se vide plus) — le passe ET son interrupteur allumé (par défaut)
local function etatNitro(p: Player, d: any)
	local on = true
	if ctx and ctx.Profils.pret(p) then
		local rg = ctx.Profils.de(p).reglages
		on = not (type(rg) == "table" and rg.nitroInf == false)
	end
	p:SetAttribute("NitroPasse", d.nitroInfini == true)
	p:SetAttribute("NitroInfini", d.nitroInfini == true and on)
	-- (rallumée en pleine partie, ou le passe acheté en route : la partie devient aidée)
	local se = session[p.UserId]
	if se and d.nitroInfini == true and on then se.aide = true end
end
local function lireDroits(p: Player)
	local d = droits[p.UserId] or { argent2 = false, nitroInfini = false, vip = false, premium = false, payes = {} }
	for nom, id in R.passes do
		local a = d.payes[nom] == true or passeSimule(nom)
		if not a and type(id) == "number" and id > 0 then
			local ok, r = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(p.UserId, id) end)
			a = if ok then r == true else (d :: any)[nom] == true -- (Roblox ne répond pas : on garde ce qu'on savait)
		end
		(d :: any)[nom] = a
	end
	d.premium = p.MembershipType == Enum.MembershipType.Premium
	droits[p.UserId] = d
	p:SetAttribute("Argent2", d.argent2)
	p:SetAttribute("VIP", d.vip)
	p:SetAttribute("Premium", d.premium)
	etatNitro(p, d)
	return d
end
function Revenus.droits(p: Player): any return droits[p.UserId] or lireDroits(p) end

-- ce que vaut 1 $ gagné en course pour ce joueur : × 2 (passe), × 1,1 (Premium)
function Revenus.multiplicateur(p: Player): number
	local d = Revenus.droits(p)
	return (d.argent2 and 2 or 1) * (d.premium and (1 + R.premiumBonus) or 1)
end

-- ── les BADGES : une fois, discrètement (BadgeService ne marche que dans un jeu publié) ──
local function badge(p: Player, nom: string)
	local id = R.badges[nom]
	local se = session[p.UserId]
	if type(id) ~= "number" or id <= 0 or not se or se.badges[nom] then return end
	se.badges[nom] = true
	task.spawn(function()
		local ok, a = pcall(function() return BadgeService:UserHasBadgeAsync(p.UserId, id) end)
		if ok and not a then pcall(function() BadgeService:AwardBadge(p.UserId, id) end) end
	end)
end
Revenus.badge = badge

-- un message pour le joueur (un bandeau, un montant qui tombe) — voir Client/Revenus
local evRevenu: RemoteEvent? = nil
local evRevivre: RemoteEvent? = nil -- (la carte de la mort attend son cœur acheté : voir Client/Revenus, offrirSeconde)
local function dire(p: Player, quoi: string, montant: number?, txt: string?)
	if evRevenu then evRevenu:FireClient(p, quoi, montant, txt) end
end
local function crediter(p: Player, prof: any, montant: number)
	prof.compte += math.floor(montant)
	An.argent(p, math.floor(montant), prof.compte, An.T.jeu, "invitation")
	ctx.Profils.pousser(p)
	ctx.compte(p, prof)
	ctx.Profils.sauverBientot(p)
end
-- ── LES CŒURS : le stock vit dans le profil, le joueur le lit sur son attribut « Coeurs » (pilote, boutique) ──
local function etatCoeurs(p: Player, prof: any)
	p:SetAttribute("Coeurs", math.max(0, math.floor(prof.coeurs or 0)))
end
-- ── LE KIT DU PILOTE : acheté une fois, il quitte la boutique (attribut « KitPris ») ──
local function etatKit(p: Player, prof: any)
	p:SetAttribute("KitPris", prof.kit == true)
end

-- ── le CADEAU DU JOUR : 7 jours qui montent, la série repart à 1 si l'on saute un jour ; VIP = doublé ──
local function etatJour(p: Player, prof: any)
	local auj = jourDe(os.time())
	local dispo = prof.jour ~= auj
	local serie = dispo and ((prof.jour == auj - 1) and prof.serie + 1 or 1) or prof.serie
	p:SetAttribute("JourDispo", dispo)
	p:SetAttribute("Serie", serie)
end
local function gainJour(p: Player, serie: number): number
	local g = R.jour[((serie - 1) % #R.jour) + 1]
	return g * (Revenus.droits(p).vip and 2 or 1)
end

-- ── les CADEAUX DE TEMPS DE JEU : dans la session (5, 15, 30, 60 min, puis toutes les heures) ; VIP = doublés ──
local function seuil(n: number): (number, number) -- le n-ième cadeau (1…) : à combien de minutes, combien
	local t = R.tempsJeu
	if n <= #t then return t[n][1], t[n][2] end
	local dernier = t[#t]
	return dernier[1] + (n - #t) * 60, dernier[2]
end

-- ── LA ROUE ──
-- ce que le joueur voit de sa roue (attributs, lus par Client/Roue) : les tours en réserve, l'heure du prochain tour gratuit (os.time,
-- comparée chez lui à workspace:GetServerTimeNow), les parties faites vers le tour offert
local function etatRoue(p: Player, prof: any)
	local r = prof.roue
	p:SetAttribute("RoueTours", r.n)
	p:SetAttribute("RoueProchain", r.libre + RO.libreH * 3600)
	p:SetAttribute("RoueParties", r.parties)
end
Revenus.etatRoue = etatRoue
local rng = Random.new()
local function tirer(): number
	local total = 0
	for _, c in RO.cases do total += c.w end
	local x = rng:NextNumber() * total
	for k, c in RO.cases do
		x -= c.w
		if x <= 0 then return k end
	end
	return 1
end
-- un tour : gratuit s'il est l'heure, sinon pris dans la réserve. Rend { case, gain?, caisse?, habit? } — le client fait tourner la
-- roue JUSQU'À la case tirée ici
local function tourner(p: Player, prof: any): (boolean, any)
	local r = prof.roue
	local t = os.time()
	if t - r.libre >= RO.libreH * 3600 then
		r.libre = t
	elseif r.n > 0 then
		r.n -= 1
	else
		return false, "pas de tour"
	end
	local k = tirer()
	-- (banc) workspace:SetAttribute("DbgRoueCase", k) force la case (Studio seulement)
	local force = workspace:GetAttribute("DbgRoueCase")
	if game:GetService("RunService"):IsStudio() and type(force) == "number" and RO.cases[force] then k = force end
	local c = RO.cases[k]
	local res: any = { case = k }
	r.attente = -1
	if c.k == "caisse" then
		local libres = {}
		for i, f in Catalogue do
			if f.cond.k == "roue" and not f.retire and not table.find(prof.caisses, i) then table.insert(libres, i) end
		end
		table.sort(libres)
		if #libres > 0 then
			local i = libres[rng:NextInteger(1, #libres)]
			table.insert(prof.caisses, i)
			r.attente = i
			res.caisse = i
		else
			res.gain = RO.revente -- (toute la collection est déjà au garage : la case paie)
		end
	elseif c.k == "habit" then
		local libres = {}
		for cat, l in Config.HABITS do
			for _, d in l do
				if d.roue and not table.find(prof.habits, cat .. ":" .. d.id) then table.insert(libres, { cat, d.id }) end
			end
		end
		if #libres > 0 then
			local h = libres[rng:NextInteger(1, #libres)]
			table.insert(prof.habits, h[1] .. ":" .. h[2])
			res.habit = h
		else
			res.gain = c.v
		end
	else
		res.gain = c.v
	end
	if res.gain then
		prof.compte += res.gain
		An.argent(p, res.gain, prof.compte, An.T.cadeau, "roue")
	end
	etatRoue(p, prof)
	ctx.compte(p, prof)
	return true, res
end

-- ════════ LES PRODUITS (achats en Robux) ════════
-- Chaque produit a un NOM — « coeur », « coeur5 », « coeur15 », « tours3 », « kit », « argent1 »…« argent5 », « caisse9 »… — et
-- tout passe par UNE porte, `recevoir` : ProcessReceipt (le vrai achat) et le banc DbgAchat (Studio) — le même chemin, la même
-- sauvegarde, le même garde-fou contre le double crédit.
local function nomProduit(id: number): string?
	if type(id) ~= "number" or id <= 0 then return nil end
	for nom, pid in R.produits do
		if pid == id then return nom end
	end
	for k, a in R.argent do
		if a.id == id then return "argent" .. k end
	end
	for i, pid in R.caisses do
		if pid == id then return "caisse" .. i end
	end
	return nil
end
-- accorde le produit `nom` (dans le profil EN MÉMOIRE — `recevoir` l'écrit ensuite) et le dit au joueur ; faux = nom inconnu
local function octroyer(p: Player, prof: any, nom: string): boolean
	local nC = R.coeursPar[nom]
	if nC then
		-- des CŒURS au stock ; la carte de la MORT attend peut-être celui-là (Revivre) : elle le dépense aussitôt, la caisse repart
		prof.coeurs += nC
		etatCoeurs(p, prof)
		dire(p, "coeur", nC, tostring(prof.coeurs))
		if evRevivre then evRevivre:FireClient(p) end
	elseif nom == "tours3" then
		prof.roue.n += 3
		etatRoue(p, prof)
		dire(p, "tours", nil, "3")
	elseif nom == "kit" then
		-- LE KIT DU PILOTE : l'argent, les cœurs, l'habillage offert (rangé au garage, pas porté d'office : la caisse du joueur se
		-- rebâtit quand IL choisit de la porter). Racheté malgré tout (deux fenêtres ouvertes) : il est payé, il est donné.
		local kt = R.kit
		prof.compte += kt.argent
		An.argent(p, kt.argent, prof.compte, An.T.achatRobux, "kit")
		prof.coeurs += kt.coeurs
		if not table.find(prof.habits, kt.habit) then table.insert(prof.habits, kt.habit) end
		prof.kit = true
		etatCoeurs(p, prof)
		etatKit(p, prof)
		ctx.compte(p, prof)
		ctx.Profils.pousser(p)
		dire(p, "kit", kt.argent, tostring(kt.coeurs))
	elseif string.sub(nom, 1, 6) == "argent" then
		local a = R.argent[tonumber(string.sub(nom, 7)) or 0]
		if not a then return false end
		prof.compte += a.v
		An.argent(p, a.v, prof.compte, An.T.achatRobux, nom)
		ctx.compte(p, prof)
		ctx.Profils.pousser(p)
		dire(p, "argent", a.v)
	elseif string.sub(nom, 1, 6) == "caisse" then
		local i = tonumber(string.sub(nom, 7))
		local f = i and Catalogue[i]
		if not i or not f or f.cond.k ~= "premium" or f.retire then return false end
		if table.find(prof.caisses, i) then
			-- (déjà à lui : la boutique cache ACHETER d'une caisse qu'on possède — deux fenêtres ouvertes en même temps, au pire)
			warn(string.format("[CashCar] %s a racheté la caisse %d qu'il possédait déjà", p.Name, i))
		else
			table.insert(prof.caisses, i)
		end
		ctx.Profils.pousser(p) -- (le garage la montre aussitôt comme à lui)
		dire(p, "caisse", nil, tostring(i))
	else
		return false
	end
	return true
end
-- LA PORTE DES ACHATS : `achat` = le numéro du reçu (PurchaseId). Rend la décision pour Roblox.
local dernierBanc: { [number]: { string } } = {} -- (banc) le dernier achat simulé, pour le « rejouer » (même reçu deux fois)
local function recevoir(p: Player, nom: string, achat: string): Enum.ProductPurchaseDecision
	local P = ctx.Profils
	-- le profil d'abord : un reçu resté en attente arrive AVEC le joueur, avant que sa sauvegarde soit lue — il attend (30 s au plus)
	local t0 = os.clock()
	while not P.pret(p) and p.Parent and os.clock() - t0 < 30 do task.wait(0.2) end
	if not P.pret(p) or not p.Parent then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local prof = P.de(p)
	-- (une session dont la sauvegarde est illisible n'écrit jamais : ce qu'on y accorderait serait perdu en partant — Roblox
	-- représentera le reçu plus tard, quand la sauvegarde répondra)
	if (prof :: any).horsLigne and not Studio then return Enum.ProductPurchaseDecision.NotProcessedYet end
	if not table.find(prof.achats, achat) then
		if not octroyer(p, prof, nom) then return Enum.ProductPurchaseDecision.NotProcessedYet end
		table.insert(prof.achats, achat)
		while #prof.achats > 30 do table.remove(prof.achats, 1) end
	end
	-- ACCORDÉ QU'UNE FOIS ÉCRIT (5/10) : sinon « pas encore » — Roblox représentera ce reçu ; il est déjà dans `achats` (en mémoire),
	-- il ne créditera pas une seconde fois, seule l'écriture sera retentée. (Studio n'écrit jamais : accordé — sauf DbgSauveKO.)
	local ecrit = P.sauverMaintenant(p)
	if Studio then ecrit = not workspace:GetAttribute("DbgSauveKO") end
	if not ecrit then
		warn(string.format("[CashCar] achat %s de %s pas encore écrit : Roblox le représentera", nom, p.Name))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ── le CLASSEMENT MONDIAL : le meilleur record SANS AIDE de chacun, les dix premiers rafraîchis toutes les 2 min ──
-- (Sacha, 5/10 : « le TOP 10 sans aide » — un cœur, la nitro infinie ou le mode facile s'achètent ou s'allument : ils ne doivent
-- pas acheter une place. Nouveau tableau v2 : l'ancien mélangeait les records aidés, il ne se trie plus.)
local classement: any = nil
do
	local ok, s = pcall(function() return DataStoreService:GetOrderedDataStore("CashCarClassement_v2") end)
	if ok then classement = s end
end
local noms: { [number]: string } = {}
local function nomDe(id: number): string
	if noms[id] then return noms[id] end
	local p = Players:GetPlayerByUserId(id)
	local ok, n = pcall(function() return p and p.DisplayName or Players:GetNameFromUserIdAsync(id) end)
	noms[id] = (ok and n) or "?"
	return noms[id]
end
local function rafraichir()
	if not classement then return end
	local ok, page = pcall(function() return classement:GetSortedAsync(false, 10):GetCurrentPage() end)
	if not ok or type(page) ~= "table" then return end
	local liste = {}
	for _, e in page do
		local id = tonumber(e.key)
		if id then table.insert(liste, { n = nomDe(id), v = e.value }) end
	end
	CC:SetAttribute("Classement", HttpService:JSONEncode(liste))
end
-- (une écriture à la première partie de la session — elle remet le tableau d'accord avec le profil — puis seulement quand le record
-- sans aide MONTE : un record se bat rarement, le budget d'écritures de Roblox reste intact)
local function inscrire(p: Player, record: number)
	local se = session[p.UserId]
	record = math.floor(record)
	if not classement or not se or record <= 0 or record <= se.inscrit then return end
	se.inscrit = record
	task.spawn(function()
		local ok = pcall(function() classement:SetAsync(tostring(p.UserId), record) end)
		if not ok and session[p.UserId] == se then se.inscrit = 0 end -- (raté : la prochaine fin de partie réessaie)
	end)
end
-- la partie démarre (le serveur lance sa montre) : part-elle déjà aidée ? (nitro infinie allumée, mode facile)
function Revenus.debut(p: Player)
	local se = session[p.UserId]
	if not se or not ctx or not ctx.Profils.pret(p) then return end
	local rg = ctx.Profils.de(p).reglages
	se.aide = p:GetAttribute("NitroInfini") == true or (type(rg) == "table" and rg.facile == true)
end

-- ════════ le branchement ════════
function Revenus.init(c: any)
	ctx = c
	evRevenu = c.remote("Revenu")
	evRevivre = c.remote("Revivre")
	local P = ctx.Profils
	-- l'interrupteur NITRO INFINIE (réglage « nitroInf ») : le pilote suit l'attribut, tout de suite
	P.surReglage = function(p: Player, prof: any, cle: string)
		if cle == "nitroInf" then etatNitro(p, Revenus.droits(p)) end
		-- (le mode FACILE allumé en pleine partie : elle devient aidée)
		if cle == "facile" and prof.reglages.facile == true and session[p.UserId] then session[p.UserId].aide = true end
	end

	-- le CADEAU DU JOUR
	P.actions.cadeauJour = function(p, prof)
		local auj = jourDe(os.time())
		if prof.jour == auj then return false, "deja pris" end
		prof.serie = (prof.jour == auj - 1) and prof.serie + 1 or 1
		prof.jour = auj
		local g = gainJour(p, prof.serie)
		prof.compte += g
		An.argent(p, g, prof.compte, An.T.cadeau, "cadeauJour")
		etatJour(p, prof)
		if prof.serie >= 7 then badge(p, "serie7") end
		dire(p, "jour", g)
		ctx.compte(p, prof)
		return true
	end
	-- les CADEAUX DE TEMPS DE JEU
	P.actions.cadeauTemps = function(p, prof)
		local se = session[p.UserId]
		if not se then return false, "pas de session" end
		local mn, g = seuil(se.n + 1)
		if workspace:GetServerTimeNow() - se.debut < mn * 60 - 2 then return false, "pas encore" end
		se.n += 1
		g *= Revenus.droits(p).vip and 2 or 1
		prof.compte += g
		An.argent(p, g, prof.compte, An.T.cadeau, "cadeauTemps")
		p:SetAttribute("CadeauN", se.n)
		dire(p, "temps", g)
		ctx.compte(p, prof)
		return true
	end
	-- le BONUS DE GROUPE (une fois) : vérifié sur la liste FRAÎCHE des groupes du joueur (il vient peut-être de rejoindre)
	P.actions.groupe = function(p, prof)
		if type(R.groupe) ~= "number" or R.groupe <= 0 then return false, "pas de groupe" end
		if prof.groupe then return false, "deja pris" end
		local ok, gs = pcall(function() return game:GetService("GroupService"):GetGroupsAsync(p.UserId) end)
		local membre = false
		if ok and type(gs) == "table" then
			for _, g in gs do if g.Id == R.groupe then membre = true end end
		end
		if not membre then return false, "pas membre" end
		prof.groupe = true
		prof.compte += R.groupeBonus
		An.argent(p, R.groupeBonus, prof.compte, An.T.accueil, "groupe")
		p:SetAttribute("GroupeFait", true)
		dire(p, "groupe", R.groupeBonus)
		ctx.compte(p, prof)
		return true
	end

	-- LA ROUE : tourner ; puis, si c'est une caisse, la GARDER (elle est équipée) ou la REVENDRE (au choix : la caisse ou l'argent)
	P.actions.roue = tourner
	P.actions.roueGarder = function(p, prof, i)
		if type(i) ~= "number" or prof.roue.attente ~= i then return false, "rien a garder" end
		prof.roue.attente = -1
		return P.actions.equiper(p, prof, i)
	end
	P.actions.roueVendre = function(p, prof, i)
		if type(i) ~= "number" or prof.roue.attente ~= i then return false, "rien a vendre" end
		local j = table.find(prof.caisses, i)
		if j then table.remove(prof.caisses, j) end
		if prof.caisse == i then prof.caisse = 0 end
		prof.roue.attente = -1
		prof.compte += RO.revente
		An.argent(p, RO.revente, prof.compte, An.T.jeu, "roueVente")
		ctx.compte(p, prof)
		return true
	end

	-- UN CŒUR SE DÉPENSE (Sacha, 5/10 : « une vie en plus sous forme de cœur ») : la caisse a explosé, le joueur a choisi UTILISER UN
	-- CŒUR sur la carte de la mort et le pilote l'a déjà replacée sur la route (il n'attend pas la réponse) — ici on retire le cœur
	-- du stock, et on refuse à zéro
	P.actions.coeur = function(p, prof)
		if (prof.coeurs or 0) < 1 then
			etatCoeurs(p, prof) -- (le joueur se croyait un cœur de trop : il relit la vérité)
			return false, "plus de coeur"
		end
		prof.coeurs -= 1
		etatCoeurs(p, prof)
		if session[p.UserId] then session[p.UserId].aide = true end -- (une vie de plus : la partie sort du TOP 10)
		An.evenement(p, "CoeurUtilise")
		return true
	end

	-- les PRODUITS (cœurs, packs, kit, argent, caisses légendaires, tours de roue) : accordés par Roblox (ProcessReceipt), une fois par
	-- achat — jamais deux fois le même reçu, et jamais « accordé » avant d'être écrit (voir `recevoir`)
	MarketplaceService.ProcessReceipt = function(info)
		local p = Players:GetPlayerByUserId(info.PlayerId)
		if not p then return Enum.ProductPurchaseDecision.NotProcessedYet end
		local nom = nomProduit(info.ProductId)
		if not nom then
			warn("[CashCar] reçu d'un produit inconnu : " .. tostring(info.ProductId) .. " (son numéro est-il dans Config.REVENUS ?)")
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local ok, d = pcall(recevoir, p, nom, tostring(info.PurchaseId))
		if ok and d == Enum.ProductPurchaseDecision.PurchaseGranted then An.evenement(p, "Robux_" .. nom, info.CurrencySpent) end
		if not ok then
			warn("[CashCar] achat " .. nom .. " : " .. tostring(d))
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		return d
	end
	-- un passe acheté EN JEU : ses droits tout de suite (noté « payé » : la réponse de Roblox, en cache, peut encore dire non)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(p, id, achete)
		if not achete then return end
		local d = Revenus.droits(p)
		for nom, pid in R.passes do
			if type(pid) == "number" and pid > 0 and pid == id then d.payes[nom] = true end
		end
		lireDroits(p)
		for nom, pid in R.passes do
			if type(pid) == "number" and pid > 0 and pid == id then dire(p, "passe", nil, nom) end
		end
	end)
	Players.PlayerMembershipChanged:Connect(function(p) lireDroits(p) end)

	-- (banc, Studio seulement) DbgPasse : voir passeSimule ; DbgCoeurs = n : le stock de cœurs de chaque joueur posé à n
	if Studio then
		workspace:GetAttributeChangedSignal("DbgPasse"):Connect(function()
			for _, p in Players:GetPlayers() do lireDroits(p) end
		end)
		workspace:GetAttributeChangedSignal("DbgCoeurs"):Connect(function()
			local n = tonumber(workspace:GetAttribute("DbgCoeurs"))
			if not n then return end
			for _, p in Players:GetPlayers() do
				local prof = P.de(p)
				prof.coeurs = math.max(0, math.floor(n))
				etatCoeurs(p, prof)
			end
		end)
		-- DbgAchat = "coeur5" | "coeur15" | "coeur" | "kit" | "argent1"…"argent5" | "caisse9"… | "tours3" : un REÇU simulé, accordé
		-- par la même porte que les vrais (`recevoir`) — un mot de plus après le nom pour rejouer le même (« coeur5 2 ») ; « rejouer »
		-- représente le DERNIER reçu simulé (il ne doit rien créditer une seconde fois) ; DbgSauveKO = true : l'écriture « rate »
		-- (le reçu répond « pas encore »)
		workspace:GetAttributeChangedSignal("DbgAchat"):Connect(function()
			local q = workspace:GetAttribute("DbgAchat")
			local nom = type(q) == "string" and string.match(q, "^%w+")
			if not nom then return end
			for _, p in Players:GetPlayers() do
				task.spawn(function()
					local recu = { nom, "BANC-" .. nom .. "-" .. HttpService:GenerateGUID(false) }
					if nom == "rejouer" then
						recu = dernierBanc[p.UserId]
						if not recu then
						print("[revenus] DbgAchat rejouer : aucun achat simulé avant")
						return
					end
					end
					dernierBanc[p.UserId] = recu
					local avant = P.de(p)
					local c0, n0 = avant.compte, avant.coeurs
					local d = recevoir(p, recu[1], recu[2])
					local prof = P.de(p)
					print(string.format("[revenus] DbgAchat %s (%s) pour %s : %s — compte %.0f → %.0f, cœurs %.0f → %.0f, kit %s, caisses %s",
						recu[1], recu[2], p.Name, tostring(d), c0, prof.compte, n0, prof.coeurs, tostring(prof.kit), table.concat(prof.caisses, ",")))
				end)
			end
		end)
	end

	task.spawn(function()
		while true do
			pcall(rafraichir)
			task.wait(120)
		end
	end)
end

-- à l'arrivée (profil chargé) : les droits, le cadeau du jour, l'horloge des cadeaux, le badge de bienvenue, l'invitation
function Revenus.arrivee(p: Player, prof: any)
	session[p.UserId] = { debut = workspace:GetServerTimeNow(), n = 0, badges = {}, inscrit = 0, aide = false }
	p:SetAttribute("CadeauDebut", session[p.UserId].debut)
	p:SetAttribute("CadeauN", 0)
	p:SetAttribute("GroupeFait", prof.groupe == true)
	lireDroits(p)
	etatJour(p, prof)
	etatRoue(p, prof)
	etatKit(p, prof)
	-- (banc) DbgCoeurs posé AVANT l'arrivée du joueur : il s'applique aussi
	local dbgC = Studio and tonumber(workspace:GetAttribute("DbgCoeurs"))
	if dbgC then prof.coeurs = math.max(0, math.floor(dbgC)) end
	etatCoeurs(p, prof)
	badge(p, "bienvenue")
	if prof.permis then badge(p, "permis") end
	-- L'INVITATION : arrivé par le lien d'un ami (une fois dans la vie du compte) — lui et l'ami présent sont récompensés
	local ok, jd = pcall(function() return p:GetJoinData() end)
	local par = ok and type(jd) == "table" and tonumber(jd.ReferredByPlayerId) or 0
	if par and par > 0 and par ~= p.UserId and (prof.invite or 0) == 0 then
		prof.invite = par
		crediter(p, prof, R.invitation)
		dire(p, "invite", R.invitation)
		local ami = Players:GetPlayerByUserId(par)
		if ami then
			local pa = ctx.Profils.de(ami)
			crediter(ami, pa, R.invitation)
			dire(ami, "ami", R.invitation, p.DisplayName)
		end
	end
end
function Revenus.depart(p: Player)
	session[p.UserId] = nil
	droits[p.UserId] = nil
end

-- à chaque fin de partie : les badges d'exploit, le classement
function Revenus.surFin(p: Player, prof: any, stats: any, aura: number?, montant: number?)
	if type(stats) ~= "table" or stats.lecon then return end
	-- LA ROUE : une vraie partie (15 s de course au moins) compte pour le tour offert
	-- (et le serveur le vérifie à sa montre : deux fins de partie à moins de 15 s d'écart ne comptent qu'une fois)
	local se = session[p.UserId]
	if type(stats.duree) == "number" and stats.duree >= 15 and se and os.clock() - (se.roueT or -100) >= 15 then
		se.roueT = os.clock()
		local r = prof.roue
		r.parties += 1
		if r.parties >= RO.parties then
			r.parties = 0
			r.n += 1
			dire(p, "tours", nil, "1")
		end
		etatRoue(p, prof)
	end
	if type(stats.zone) == "number" and stats.zone >= 6 then badge(p, "zone6") end
	if type(stats.tier) == "number" and stats.tier >= 9 then badge(p, "moteur10") end
	if type(aura) == "number" and aura >= 1000 then badge(p, "aura1000") end
	if prof.record >= 1e6 then badge(p, "millionnaire") end
	if prof.permis then badge(p, "permis") end
	-- LE TOP 10 SANS AIDE : la partie n'y monte que si rien ne l'a aidée, du départ à l'explosion (et rien d'allumé à l'arrivée)
	local rg = prof.reglages
	local aidee = (se and se.aide) or p:GetAttribute("NitroInfini") == true or (type(rg) == "table" and rg.facile == true)
	if not aidee and type(montant) == "number" and montant > prof.recordPur then prof.recordPur = montant end
	if se then se.aide = false end
	inscrire(p, prof.recordPur)
end

return Revenus
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX000000D0"><Properties><string name="Name">Serveur</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LE SERVEUR. Il fait peu, exprès :
--   1. il tire la GRAINE de la piste (tout le serveur roule sur la même route : chaque joueur la bâtit
--      chez lui à partir de ce nombre — zéro pièce de route à envoyer sur le réseau) ;
--   2. il pose le CIEL (lumière, atmosphère) ;
--   3. il tient une caisse ANCRÉE par joueur, qui ne porte que la position envoyée par ce joueur (chacun
--      dessine les caisses chez lui ; celle-ci sert de boîte aux lettres pour que les autres la voient) ;
--   4. il tient le CLASSEMENT et la SAUVEGARDE (record à vie + COMPTE cumulé, comme le compte du jeu web).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local CC = ReplicatedStorage:WaitForChild("CashCar")
local Config = require(CC:WaitForChild("Config"))
local Ciel = require(CC:WaitForChild("Ciel"))

workspace.Gravity = 0 -- la physique de la caisse est à nous (aussi posé dans le fichier)
Players.CharacterAutoLoads = false

-- ── 1. la graine ──
local graine = Config.GRAINE_FIXE or (os.time() % 900000 + 1000)
CC:SetAttribute("Graine", graine)

-- ── 2. le ciel ──
Ciel.poser(Lighting, workspace)

-- ── les tuyaux vers les joueurs ──
local function remote(nom: string, classe: string?)
	local ok, r = pcall(function() return Instance.new(classe or "RemoteEvent") end)
	if not ok then r = Instance.new("RemoteEvent") end -- (UnreliableRemoteEvent absent : repli)
	r.Name = nom
	r.Parent = CC
	return r
end
local evFin = remote("FinPartie")                           -- fin de partie (montant, distance)
local evEtat = remote("EtatCaisse")                         -- menu / course, zone, nitro
local evRecord = remote("Record")                           -- record à vie + compte, rendus au joueur
local evPos = remote("PosCaisse", "UnreliableRemoteEvent")  -- la position de la caisse, 15 fois/s

-- ── 3. les caisses ──
local dossier = Instance.new("Folder")
dossier.Name = "Caisses"
dossier.Parent = workspace

-- ── 4. les profils (compte, caisses, missions, carrière, réglages — voir Profils) ──
local Profils = require(script.Parent:WaitForChild("Profils"))
local fnProfil = remote("Profil", "RemoteFunction")   -- le client lit son profil
local fnAction = remote("Action", "RemoteFunction")   -- le client demande (acheter, équiper, régler…), le serveur vérifie
local evProfil = remote("ProfilMaj")                  -- le serveur pousse le profil à jour
Profils.pousser = function(p: Player) evProfil:FireClient(p, Profils.de(p)) end
-- LES REVENUS : cadeaux, badges, classement, passes, cœurs (voir Revenus)
local Revenus = require(script.Parent:WaitForChild("Revenus"))
local Analytique = require(script.Parent:WaitForChild("Analytique")) -- (les statistiques Roblox : entonnoir, économie)
Profils.surHabit = function(p: Player) -- la peinture, les ailes, la traînée : les autres doivent les voir
	local m = dossier:FindFirstChild(p.Name)
	local prof = Profils.de(p)
	if m then
		m:SetAttribute("Peinture", prof.porte.peinture)
		m:SetAttribute("Aile", prof.porte.aile)
		m:SetAttribute("Trainee", prof.porte.trainee)
	end
end
Profils.surEquipe = function(p: Player, i: number) -- la caisse équipée change : les autres doivent la redessiner
	local m = dossier:FindFirstChild(p.Name)
	if m then m:SetAttribute("Caisse", i) end
end

fnProfil.OnServerInvoke = function(p)
	return Profils.de(p)
end
fnAction.OnServerInvoke = function(p, nom, ...)
	local f = Profils.actions[nom]
	if type(nom) ~= "string" or not f then return false, "action inconnue", Profils.de(p) end
	local prof = Profils.de(p)
	local ok, res, msg = pcall(f, p, prof, ...)
	if not ok then return false, "erreur", prof end
	if res then Profils.sauverBientot(p) end
	return res, msg, prof
end

local function arrivee(p: Player)
	if dossier:FindFirstChild(p.Name) then return end
	-- le tableau des scores (en haut à droite chez Roblox)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local rec = Instance.new("NumberValue")
	rec.Name = "Record $"
	rec.Parent = ls
	local der = Instance.new("NumberValue")
	der.Name = "Dernier $"
	der.Parent = ls
	ls.Parent = p

	-- sa boîte aux lettres : une racine invisible et ancrée, qui ne porte que la position envoyée par le joueur
	-- et ce que les autres doivent savoir pour DESSINER sa caisse (laquelle, en course ou non, quelle zone, nitro)
	local m = Instance.new("Model")
	m.Name = p.Name
	local r = Instance.new("Part")
	r.Name = "Racine"
	r.Size = Vector3.new(1, 1, 1)
	r.Transparency = 1
	r.Anchored = true
	r.CanCollide = false
	r.CanQuery = false
	r.CanTouch = false
	r.CFrame = CFrame.new(0, Config.GARAGE_Y, 0)
	r.Parent = m
	m.PrimaryPart = r
	m:SetAttribute("Joueur", p.UserId)
	m:SetAttribute("EnCourse", false)
	m:SetAttribute("Caisse", 0)
	m.Parent = dossier

	task.spawn(function()
		local prof = Profils.charger(p)
		m:SetAttribute("Caisse", prof.caisse)
		Profils.surHabit(p)
		rec.Value = math.floor(prof.record)
		evRecord:FireClient(p, prof.record, prof.compte)
		Profils.pousser(p)
		Revenus.arrivee(p, prof)
		Analytique.arrivee(p, prof)
	end)
end
-- LA MONTRE DU SERVEUR (4/10, avant publication) : quand une partie commence, le serveur le note — à la fin, il sait combien de
-- temps elle a VRAIMENT duré, et borne le montant déclaré par le joueur (voir evFin). Un cœur dépensé (la vie de plus) ne relance pas la montre.
-- (5/10 : déclarée ICI, avant le départ d'un joueur qui la vide — déclarée plus bas, elle était inconnue à cet endroit :
-- le départ plantait AVANT la sauvegarde du profil)
local debutCourse: { [number]: number } = {}
Players.PlayerAdded:Connect(arrivee)
Revenus.init({ Profils = Profils, remote = remote, compte = function(p: Player, prof: any) evRecord:FireClient(p, prof.record, prof.compte) end })
-- en test dans Studio, le joueur peut être entré AVANT que ce script écoute : on le rattrape
for _, p in Players:GetPlayers() do task.spawn(arrivee, p) end

-- (la SAUVEGARDE d'abord : rien de ce qui suit ne doit pouvoir l'empêcher)
Players.PlayerRemoving:Connect(function(p)
	pcall(Profils.sauver, p)
	Profils.oublier(p)
	debutCourse[p.UserId] = nil
	local m = dossier:FindFirstChild(p.Name)
	if m then m:Destroy() end
	Revenus.depart(p)
end)

-- (à l'arrêt d'un serveur, Roblox laisse 30 s : toutes les sauvegardes partent EN MÊME TEMPS, pas l'une après l'autre)
game:BindToClose(function()
	local reste = 0
	for _, p in Players:GetPlayers() do
		reste += 1
		task.spawn(function()
			pcall(Profils.sauver, p)
			reste -= 1
		end)
	end
	local t0 = os.clock()
	while reste > 0 and os.clock() - t0 < 25 do task.wait(0.1) end
end)

-- ce que les AUTRES doivent savoir de ma caisse : est-ce que je roule, dans quelle zone, nitro allumée ?
evEtat.OnServerEvent:Connect(function(p, quoi, valeur)
	if quoi == "course" and valeur == true and not debutCourse[p.UserId] then
		debutCourse[p.UserId] = os.clock()
		Revenus.debut(p) -- (la partie part-elle SANS AIDE ? le TOP 10 n'inscrit que celles-là)
		Analytique.debut(p)
	end
	local m = dossier:FindFirstChild(p.Name)
	if not m then return end
	if quoi == "course" then
		m:SetAttribute("EnCourse", valeur == true)
		if valeur ~= true then m:SetAttribute("Nitro", false) end
	elseif quoi == "zone" and type(valeur) == "number" and valeur >= 1 and valeur < 1000 then
		m:SetAttribute("Zone", math.floor(valeur))
	elseif quoi == "nitro" then
		m:SetAttribute("Nitro", valeur == true)
	end
end)

-- la position : 20 fois par seconde au plus, jamais un nombre aberrant
local derPos: { [number]: number } = {}
evPos.OnServerEvent:Connect(function(p, cf, sP, rel)
	if typeof(cf) ~= "CFrame" then return end
	local t = os.clock()
	if derPos[p.UserId] and t - derPos[p.UserId] < 1 / 20 then return end
	derPos[p.UserId] = t
	local v = cf.Position
	if v ~= v or math.abs(v.X) > 1e6 or math.abs(v.Y) > 1e6 or math.abs(v.Z) > 1e6 then return end
	local m = dossier:FindFirstChild(p.Name)
	if m and m.PrimaryPart then m.PrimaryPart.CFrame = cf end
	-- (la place sur la piste : chacun la reporte sur SA route — voir G.poseDouble chez le joueur)
	if m and type(sP) == "number" and sP == sP and sP >= 0 and sP < 1e6 and typeof(rel) == "CFrame" and rel.Position.Magnitude < 1e5 then
		m:SetAttribute("S", sP)
		m:SetAttribute("Rel", rel)
	end
end)

-- Fin de partie : le montant vient du joueur. On le borne (un montant absurde est ignoré) —
-- l'argent est VERSÉ AU COMPTE (le compte du web), le record et les stats suivent.
local dernierEnvoi: { [number]: number } = {}
evFin.OnServerEvent:Connect(function(p, montant, distance, aura, stats)
	if type(montant) ~= "number" or montant ~= montant or montant < 0 or montant > 1e15 then return end
	local t = os.clock()
	if dernierEnvoi[p.UserId] and t - dernierEnvoi[p.UserId] < 2 then return end
	dernierEnvoi[p.UserId] = t
	-- LE PLAFOND (4/10) : le montant vient du joueur — un tricheur pouvait s'inventer des milliards et squatter le classement mondial.
	-- Mesuré au banc en jouant « parfait » (immortel, nitro tenue) : ~1 500 $ à 1 min, ~94 000 $ à 6 min. Le plafond laisse dix fois
	-- plus (2 000 + 8 × durée²) : aucun vrai joueur ne le touche, une fortune inventée y est ramenée.
	local duree = debutCourse[p.UserId] and (t - debutCourse[p.UserId]) or 0
	debutCourse[p.UserId] = nil
	local plafond = 2000 + 8 * duree * duree
	if montant > plafond then
		warn(string.format("[CashCar] fin de partie bornée : %s annonçait %.0f $ en %.0f s (plafond %.0f)", p.Name, montant, duree, plafond))
		montant = plafond
	end
	local prof = Profils.de(p)
	-- on ne verse que les GAINS, jamais la mise de 1,61 $ — multipliés par les droits du joueur (passe ×2 ARGENT, Premium +10 %)
	local gain = math.max(0, montant - Config.CASH_DEPART) * Revenus.multiplicateur(p)
	prof.compte += gain
	Analytique.argent(p, gain, prof.compte, Analytique.T.jeu, "course")
	Analytique.fin(p, montant, stats, duree)
	-- (L31161) une LEÇON QUITTÉE n'est pas une partie : seul l'argent gagné est versé — ni record, ni aura, ni partie comptée
	if type(stats) == "table" and stats.lecon == true then
		evRecord:FireClient(p, prof.record, prof.compte)
		Profils.pousser(p)
		Profils.sauverBientot(p)
		return
	end
	if montant > prof.record then prof.record = montant end
	if type(aura) == "number" and aura == aura and aura >= 0 and aura < 1e12 then
		prof.auraMeilleur = math.max(prof.auraMeilleur, aura)
		prof.aura += math.floor(aura + 0.5)
	end
	if type(stats) == "table" and type(stats.frenRec) == "number" and stats.frenRec == stats.frenRec and stats.frenRec >= 5 and stats.frenRec < 3600 then
		prof.frenRec = math.max(prof.frenRec, stats.frenRec)
	end
	if type(stats) == "table" and type(stats.kmh) == "number" and stats.kmh == stats.kmh and stats.kmh > 0 and stats.kmh < 1e5 then
		prof.kmhMax = math.max(prof.kmhMax, math.floor(stats.kmh + 0.5))
	end
	if type(stats) == "table" and type(stats.tier) == "number" and stats.tier == math.floor(stats.tier) and stats.tier >= 0 and stats.tier < 200 then
		prof.moteurMax = math.max(prof.moteurMax, stats.tier)
	end
	prof.stats.parties += 1
	if type(distance) == "number" and distance == distance and distance > 0 and distance < 1e7 then
		prof.stats.distance += distance
	end
	if type(stats) == "table" then
		for _, k in { "pieces", "figures" } do
			local v = stats[k]
			if type(v) == "number" and v == v and v >= 0 and v < 1e6 then prof.stats[k] += v end
		end
		if Profils.finPartie then pcall(Profils.finPartie, p, prof, stats) end -- (carrière)
		pcall(Revenus.surFin, p, prof, stats, aura, montant) -- (les badges d'exploit, le classement mondial)
	end
	local ls = p:FindFirstChild("leaderstats")
	if ls then
		ls["Dernier $"].Value = math.floor(montant)
		ls["Record $"].Value = math.floor(prof.record)
	end
	evRecord:FireClient(p, prof.record, prof.compte)
	Profils.pousser(p)
	Profils.sauverBientot(p)
end)
]]></ProtectedString></Properties></Item></Item><Item class="StarterGui" referent="RBX000000D2"><Properties><string name="Name">StarterGui</string></Properties></Item><Item class="SoundService" referent="RBX000000D3"><Properties><string name="Name">SoundService</string></Properties></Item></roblox>