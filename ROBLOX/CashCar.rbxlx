		desc = "Pas de capot, pas de pitié, pas de feu rouge. La ville a appelé à l'aide : c'est lui qui a répondu.", descEN = "No hood, no mercy, no red lights. The city called for help: it's the one that answered." },
	[60] = { nom = "LE MUR DU SON", en = "THE SOUND BARRIER", rar = "legendaire", gabarit = "e_murduson", cond = { k = "premium", eur = "6,99 €" },
