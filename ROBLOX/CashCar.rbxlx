return {
	corps = {
		o = { v = "OPpUC9zzwIocADD46AOY78CKHAA4+lQLJAzAihwAMPjoA2gQwIocAMgFVAskDMCKHADQB+gDaBDAihwAyAVUC9zzwIocANAH6AOY78CKHAAAAFQLAADAihwAAADoAwAAwIocAEwEWAvwCtmaHABMBFgLMPjZmhwAtPtYC/AK2ZocALT7WAsw+NmaHAA=", t = "AAABAAIAAQADAAIAAgADAAQAAwAFAAQABAAFAAYABQAHAAYABgAHAAAABwABAAAAAAACAAgAAgAEAAgABAAGAAgABgAAAAgAAwABAAkABQADAAkABwAFAAkAAQAHAAkACgALAAwACwANAAwA" },
		g = { v = "UPuUDKD2DRYgAFD7VAug9g0WIABQ+5QMiPoNFiAAUPtUC4j6DRYgALAElAyI+g0WIACwBFQLiPoNFiAAsASUDKD2DRYgALAEVAug9g0WIAA=", t = "AAABAAIAAQADAAIABAAFAAYABQAHAAYABAAGAAIABgAAAAIABwAFAAEABQADAAEABgAHAAAABwABAAAAAgADAAQAAwAFAAQA" },
		m = { v = "lPgQBMTwFBYaAJT4gALE8BQWGgCU+BAEPA8UFhoAlPiAAjwPFBYaAGwHEAQ8DxQWGgBsB4ACPA8UFhoAbAcQBMTwFBYaAGwHgALE8BQWGgA=", t = "AAABAAIAAQADAAIABAAFAAYABQAHAAYABAAGAAIABgAAAAIABwAFAAEABQADAAEABgAHAAAABwABAAAAAgADAAQAAwAFAAQA" },
		c = { v = "", t = "" },
