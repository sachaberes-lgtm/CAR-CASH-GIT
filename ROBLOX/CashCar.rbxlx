-- En unités de nuage (un nuage de rayon r se pose à l'échelle r) ; base = le plancher de condensation, sommet = le plus haut bourgeon.
-- genre = la famille du tirage (COTON_GENRES ; « classique » pour les six premiers), forme = ce que le sculpteur a bâti.
return {
	[0] = { genre = "classique", forme = "mediocris", base = -0.35, sommet = 0.67, triangles = 824, fin = 4052, mn = { -0.948, -0.376, -0.998 }, mx = { 0.883, 0.586, 0.871 } },
	[1] = { genre = "classique", forme = "humilis", base = -0.35, sommet = 0.483, triangles = 440, fin = 2120, mn = { -1.17, -0.372, -0.753 }, mx = { 1.172, 0.398, 0.608 } },
	[2] = { genre = "classique", forme = "congestus", base = -0.35, sommet = 1.311, triangles = 692, fin = 3216, mn = { -1.23, -0.362, -0.847 }, mx = { 1.217, 1.289, 0.928 } },
	[3] = { genre = "classique", forme = "humilis", base = -0.35, sommet = 0.431, triangles = 436, fin = 2132, mn = { -1.095, -0.367, -0.65 }, mx = { 1.257, 0.377, 0.737 } },
	[4] = { genre = "classique", forme = "stratocumulus", base = -0.35, sommet = 0.189, triangles = 412, fin = 2028, mn = { -1.002, -0.378, -0.442 }, mx = { 0.906, 0.15, 0.547 } },
	[5] = { genre = "classique", forme = "mediocris", base = -0.35, sommet = 0.708, triangles = 776, fin = 3880, mn = { -1.09, -0.363, -0.938 }, mx = { 0.968, 0.683, 0.939 } },
	[6] = { genre = "humilis", forme = "humilis", base = -0.35, sommet = 0.483, triangles = 520, fin = 2480, mn = { -1.066, -0.368, -0.792 }, mx = { 1.028, 0.376, 0.592 } },
	[7] = { genre = "humilis", forme = "humilis", base = -0.35, sommet = 0.475, triangles = 496, fin = 2384, mn = { -1.015, -0.364, -0.751 }, mx = { 1.273, 0.367, 0.752 } },
	[8] = { genre = "mediocris", forme = "mediocris", base = -0.35, sommet = 0.808, triangles = 700, fin = 3332, mn = { -1.038, -0.357, -0.775 }, mx = { 1.029, 0.75, 0.846 } },
	[9] = { genre = "mediocris", forme = "mediocris", base = -0.35, sommet = 0.683, triangles = 664, fin = 3160, mn = { -1.276, -0.379, -0.698 }, mx = { 0.75, 0.661, 1.008 } },
	[10] = { genre = "mediocris", forme = "mediocris", base = -0.35, sommet = 0.734, triangles = 612, fin = 2940, mn = { -1.165, -0.368, -0.718 }, mx = { 1.036, 0.671, 1.035 } },
	[11] = { genre = "congestus", forme = "congestus", base = -0.35, sommet = 2.001, triangles = 736, fin = 3616, mn = { -1.133, -0.359, -0.871 }, mx = { 1.261, 1.97, 0.663 } },
	[12] = { genre = "congestus", forme = "congestus", base = -0.35, sommet = 1.413, triangles = 820, fin = 3928, mn = { -0.996, -0.365, -0.967 }, mx = { 1.135, 1.363, 0.832 } },
	[13] = { genre = "congestus", forme = "congestus", base = -0.35, sommet = 1.654, triangles = 824, fin = 4256, mn = { -0.815, -0.364, -0.756 }, mx = { 1.236, 1.62, 0.882 } },
