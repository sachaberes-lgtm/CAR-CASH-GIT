		g = { v = "", t = "AAABAAIAAAACAAMABAAFAAYABAAHAAUAAQAIAAkAAQAJAAIABgAJAAgABgAFAAkAAwACAAoAAwAKAAsABwAMAAUABwANAAwAAgAJAA4AAgAOAAoABQAOAAkABQAMAA4ADwAQABEADwARABIAEwAUABUAEwAWABQAFwAYABkAFwAZABoAGwAcAB0AGwAeABwAGAAfACAAGAAgABkAHQAgAB8AHQAcACAAGgAZACEAGgAhACIAHgAjABwAHgAkACMAGQAgACUAGQAlACEAHAAlACAAHAAjACUA" },
		l = { v = "", t = "" },
	},
	roue = {
		m = { v = "", t = "" },
		c = { v = "", t = "" },
		o = { v = "/v4AAKX//8JKACb/AACl///CSgD+/sD/wP//wkoAJv/A/8D//8JKAP7+pf8AAP/CSgAm/6X/AAD/wkoA/v7A/0AA/8JKACb/wP9AAP/CSgD+/gAAWwD/wkoAJv8AAFsA/8JKAP7+QABAAP/CSgAm/0AAQAD/wkoA/v5bAAAA/8JKACb/WwAAAP/CSgD+/kAAwP//wkoAJv9AAMD//8JKAP7+AAAAAP/CSgAm/wAAAAD/wkoA", t = "AAABAAIAAQADAAIAAgADAAQAAwAFAAQABAAFAAYABQAHAAYABgAHAAgABwAJAAgACAAJAAoACQALAAoACgALAAwACwANAAwADAANAA4ADQAPAA4ADgAPAAAADwABAAAAAAACABAAAgAEABAABAAGABAABgAIABAACAAKABAACgAMABAADAAOABAADgAAABAAAwABABEABQADABEABwAFABEACQAHABEACwAJABEADQALABEADwANABEAAQAPABEA" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000049"><Properties><string name="Name">F65</string><ProtectedString name="Source"><![CDATA[-- CASH CAR — LA PUCE (caisse 65, gabarit d_puce) — CUIT par outils/cuire-caisses.js, ne pas éditer.
