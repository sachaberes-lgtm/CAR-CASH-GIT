+#!/usr/bin/env python3
+# planche.py <dossier> <sortie.jpg> <graine> <orient> <tagA> <tagB> [vues]  : AVANT (ligne 1) / APRÈS (ligne 2), mêmes vues, JPEG <= 250 Ko
+import sys, os
+from PIL import Image, ImageDraw
+d, out, g, o, ta, tb = sys.argv[1:7]
+vues = (sys.argv[7] if len(sys.argv) > 7 else 'a300,a150,a50,in,out,apres,profil').split(',')
+tw = 300 if o == 'pay' else 150
+rows = []
+for t in (ta, tb):
+    row = []
+    for v in vues:
+        f = os.path.join(d, f'{t}-g{g}-{o}-{v}.jpg')
+        im = Image.open(f).convert('RGB') if os.path.exists(f) else Image.new('RGB', (844, 390) if o == 'pay' else (390, 844), (40, 0, 0))
+        im = im.resize((tw, int(im.height * tw / im.width)), Image.LANCZOS)
+        row.append(im)
+    rows.append(row)
+th = rows[0][0].height
+W, H = tw * len(vues), (th + 16) * 2
+P = Image.new('RGB', (W, H), (0, 0, 0))
+dr = ImageDraw.Draw(P)
+for r, row in enumerate(rows):
+    for c, im in enumerate(row):
+        P.paste(im, (c * tw, r * (th + 16) + 16))
+        dr.text((c * tw + 3, r * (th + 16) + 2), f'{(ta, tb)[r]} g{g} {vues[c]}', fill=(255, 255, 0))
+q = 80
+while True:
+    P.save(out, 'JPEG', quality=q)
+    if os.path.getsize(out) <= 250000 or q <= 30:
+        break
+    q -= 8
+print(out, os.path.getsize(out), q)
